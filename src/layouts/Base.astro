---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const SITE_NAME = 'Corey Wininger';
const DEFAULT_DESCRIPTION =
  "Corey Wininger — IT infrastructure leader. I write about running operations, putting AI to work in the enterprise, and keeping hybrid cloud honest.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = '/og-default.png',
  canonical,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const origin = Astro.site?.href ?? Astro.url.origin;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, origin).href;
const ogImageURL = new URL(image, origin).href;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      (function () {
        var DARK_BG  = '#12151C';
        var LIGHT_BG = '#FAFAF7';
        try {
          var stored = localStorage.getItem('theme');
          var explicit = stored === 'light' || stored === 'dark';
          var theme;
          if (explicit) {
            theme = stored;
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
            theme = 'light';
          } else {
            theme = 'dark';
          }
          document.documentElement.setAttribute('data-theme', theme);

          // The paired <meta name="theme-color"> tags below this script
          // aren't in the DOM yet — this script runs first and blocks the
          // parser. Defer the collapse to DOMContentLoaded. The meta tags
          // affect mobile browser chrome only (not body paint), so deferring
          // doesn't cause a visible flash.
          if (explicit) {
            document.addEventListener('DOMContentLoaded', function () {
              var existing = document.querySelectorAll('meta[name="theme-color"]');
              for (var i = 0; i < existing.length; i++) existing[i].parentNode.removeChild(existing[i]);
              var m = document.createElement('meta');
              m.setAttribute('name', 'theme-color');
              m.setAttribute('content', theme === 'light' ? LIGHT_BG : DARK_BG);
              document.head.appendChild(m);
            });
          }
        } catch (e) {
          /* localStorage blocked / parse error — fall back to dark, no-op */
        }
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FAFAF7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12151C" media="(prefers-color-scheme: dark)" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE_NAME} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href="/rss.xml"
    />

    <!-- Cloudflare Web Analytics -->
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "1e7a78fde1224830b8d35b4c788e7138"}'></script>
    <!-- End Cloudflare Web Analytics -->

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-bg-elevated focus:px-3 focus:py-2 focus:text-text-primary"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
