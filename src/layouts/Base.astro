---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import BackToTop from '../components/BackToTop.astro';
import SearchMeta from '../components/SearchMeta.astro';
import { THEME_BG, FONTS, DEFAULT_THEME, DEFAULT_FONT } from '../data/appearance';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Last section runs to the footer with no gap (posts, landing pages). */
  flushFooter?: boolean;
  /** How this page appears in site search. Defaults to a "Pages" result
      whose subtitle is the meta description. */
  search?: { kind: 'post' | 'tool' | 'project' | 'page'; sub?: string; color?: string };
}

const SITE_NAME = 'Corey Wininger';
const DEFAULT_DESCRIPTION =
  "Corey Wininger writes about running IT operations, explaining IT to the business, and where AI actually helps.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image = '/og-default.png',
  canonical,
  ogType = 'website',
  noindex = false,
  flushFooter = false,
  search,
} = Astro.props;

const origin = Astro.site?.href ?? Astro.url.origin;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, origin).href;
const ogImageURL = new URL(image, origin).href;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;

// Search result defaults for ordinary pages: subtitle = meta description,
// dot color = the section's color in the nav.
const SECTION_COLORS: Record<string, string> = {
  blog: 'cyan',
  lab: 'green',
  projects: 'yellow',
  now: 'magenta',
  about: 'blue',
  contact: 'accent',
};
const section = Astro.url.pathname.split('/').filter(Boolean)[0] ?? '';
const searchMeta = {
  kind: search?.kind ?? 'page',
  // Result title is the page name ("About"), not its greeting-style <h1>.
  title: title ?? 'Home',
  sub: search?.sub ?? description,
  color: search?.color ?? SECTION_COLORS[section] ?? 'accent',
};

// Runs synchronously in <head>, before first paint: applies the reader's
// saved theme + font set (no flash; a saved value that is no longer in
// appearance.ts is removed from localStorage), keeps <meta name="theme-color"> in step,
// and flags Apple platforms so the search shortcut label reads ⌘K vs Ctrl K.
const prePaint = `(function(){var d=document.documentElement;d.setAttribute('data-js','');var T=${JSON.stringify(THEME_BG)},F=${JSON.stringify(FONTS.map((f) => f.id))};try{var t=localStorage.getItem('theme');if(t!==null){if(typeof T[t]==='string'&&T.hasOwnProperty(t)){d.setAttribute('data-theme',t);var m=document.querySelector('meta[name="theme-color"]');if(m)m.setAttribute('content',T[t]);}else{localStorage.removeItem('theme');}}var f=localStorage.getItem('font');if(f!==null){if(F.indexOf(f)>-1){d.setAttribute('data-font',f);}else{localStorage.removeItem('font');}}}catch(e){}try{var p=(navigator.userAgentData&&navigator.userAgentData.platform)||navigator.platform||'';if(/mac|iphone|ipad|ipod/i.test(p))d.setAttribute('data-platform','mac');}catch(e){}})();`;
---

<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME} data-font={DEFAULT_FONT}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={THEME_BG[DEFAULT_THEME]} />
    <script is:inline set:html={prePaint} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    {/* PNG-only icon links (no SVG link). /favicon.ico still exists at the
        root for clients that request it directly. */}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Default set: preloaded. */}
    <Font cssVariable="--af-redhat-display" preload />
    <Font cssVariable="--af-redhat-text" preload />
    <Font cssVariable="--af-redhat-mono" preload />
    {/* Alternates: @font-face only, fetched when a reader selects the set. */}
    <Font cssVariable="--af-plex-sans" />
    <Font cssVariable="--af-plex-mono" />
    <Font cssVariable="--af-geist" />
    <Font cssVariable="--af-geist-mono" />
    <Font cssVariable="--af-martian-mono" />
    <Font cssVariable="--af-jetbrains-mono" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE_NAME} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href="/rss.xml"
    />

    <!-- Cloudflare Web Analytics -->
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "1e7a78fde1224830b8d35b4c788e7138"}'></script>
    <!-- End Cloudflare Web Analytics -->

    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-surface focus:px-3 focus:py-2 focus:text-text"
    >
      Skip to content
    </a>
    <Header />
    {/* noindex pages (404) stay out of site search too. */}
    <main id="main" class="flex-1" data-pagefind-body={noindex ? undefined : ''}>
      {!noindex && <SearchMeta {...searchMeta} />}
      <slot />
    </main>
    <Footer flush={flushFooter} />
    <BackToTop />
    <SearchOverlay />
  </body>
</html>
