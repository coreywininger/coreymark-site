---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import PostToc from '../components/PostToc.astro';
import ReadingProgress from '../components/ReadingProgress.tsx';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  pillar?: string;
  tags?: string[];
  image?: string;
  headings: MarkdownHeading[];
  prev?: { slug: string; title: string } | null;
  next?: { slug: string; title: string } | null;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  pillar,
  tags,
  image,
  headings,
  prev,
  next,
} = Astro.props;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<Base title={title} description={description} image={image} ogType="article">
  <ReadingProgress client:load />

  <article class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-12">
    <div class="min-w-0">
      <header class="mb-10">
        {pillar && (
          <div class="mb-3 text-xs font-semibold uppercase tracking-wide text-accent-primary">
            {pillar}
          </div>
        )}
        <h1 class="mb-4 text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
          {title}
        </h1>
        <p class="mb-5 text-lg text-text-secondary">{description}</p>
        <div class="flex flex-wrap items-center gap-x-2 text-sm text-text-tertiary">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated{' '}
                <time datetime={updatedDate.toISOString()}>
                  {formatDate(updatedDate)}
                </time>
              </span>
            </>
          )}
          {tags && tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              <ul class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <li class="text-text-tertiary">#{tag}</li>
                ))}
              </ul>
            </>
          )}
        </div>
      </header>

      <div class="prose prose-invert">
        <slot />
      </div>

      {(prev || next) && (
        <nav
          aria-label="Adjacent posts"
          class="mt-16 grid gap-4 border-t border-border-subtle pt-8 sm:grid-cols-2"
        >
          {prev ? (
            <a
              href={`/blog/${prev.slug}`}
              class="group rounded-lg border border-border-subtle bg-bg-elevated p-4 transition-colors hover:border-accent-primary"
            >
              <div class="text-xs uppercase tracking-wide text-text-tertiary">
                ← Previous
              </div>
              <div class="mt-1 text-text-primary group-hover:text-accent-primary">
                {prev.title}
              </div>
            </a>
          ) : <div />}
          {next ? (
            <a
              href={`/blog/${next.slug}`}
              class="group rounded-lg border border-border-subtle bg-bg-elevated p-4 text-right transition-colors hover:border-accent-primary"
            >
              <div class="text-xs uppercase tracking-wide text-text-tertiary">
                Next →
              </div>
              <div class="mt-1 text-text-primary group-hover:text-accent-primary">
                {next.title}
              </div>
            </a>
          ) : <div />}
        </nav>
      )}
    </div>

    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <PostToc headings={headings} />
      </div>
    </aside>
  </article>
</Base>
