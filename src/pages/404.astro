---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Page Not Found" noindex={true}>
  <div class="inc-page" id="main">

    <!-- Page header: breadcrumb + timestamp -->
    <div class="inc-header">
      <div class="inc-breadcrumb">
        <a href="/">coreymark.com</a> / status
      </div>
      <div class="inc-ts" id="inc-page-ts" aria-live="off">—</div>
    </div>

    <!-- Amber status banner -->
    <div class="inc-banner" role="status" aria-label="Partial outage — 1 service unavailable">
      <div class="inc-banner-dot" aria-hidden="true"></div>
      <div class="inc-banner-text">Partial outage — 1 service unavailable</div>
      <div class="inc-banner-badge" aria-hidden="true">Investigating</div>
    </div>

    <!-- Services table -->
    <div class="inc-section-label" aria-hidden="true">Services</div>
    <div class="inc-services" role="table" aria-label="Service status">

      <div class="inc-services-head" role="row">
        <span role="columnheader">Service</span>
        <span role="columnheader">Status</span>
        <span role="columnheader">Uptime</span>
      </div>

      <div class="inc-row" role="row">
        <div class="inc-svc-col">
          <div class="inc-svc-name-row"><span class="inc-dot inc-dot--green" aria-hidden="true"></span><span>Homepage</span></div>
          <span class="inc-svc-path">/</span>
        </div>
        <div class="inc-status inc-status--ok" role="cell">Operational</div>
        <div class="inc-uptime" role="cell">100%</div>
      </div>

      <div class="inc-row" role="row">
        <div class="inc-svc-col">
          <div class="inc-svc-name-row"><span class="inc-dot inc-dot--green" aria-hidden="true"></span><span>Blog</span></div>
          <span class="inc-svc-path">/blog</span>
        </div>
        <div class="inc-status inc-status--ok" role="cell">Operational</div>
        <div class="inc-uptime" role="cell">100%</div>
      </div>

      <div class="inc-row" role="row">
        <div class="inc-svc-col">
          <div class="inc-svc-name-row"><span class="inc-dot inc-dot--green" aria-hidden="true"></span><span>Lab</span></div>
          <span class="inc-svc-path">/lab</span>
        </div>
        <div class="inc-status inc-status--ok" role="cell">Operational</div>
        <div class="inc-uptime" role="cell">100%</div>
      </div>

      <div class="inc-row" role="row">
        <div class="inc-svc-col">
          <div class="inc-svc-name-row"><span class="inc-dot inc-dot--green" aria-hidden="true"></span><span>About</span></div>
          <span class="inc-svc-path">/about</span>
        </div>
        <div class="inc-status inc-status--ok" role="cell">Operational</div>
        <div class="inc-uptime" role="cell">100%</div>
      </div>

      <div class="inc-row" role="row">
        <div class="inc-svc-col">
          <div class="inc-svc-name-row"><span class="inc-dot inc-dot--green" aria-hidden="true"></span><span>Now</span></div>
          <span class="inc-svc-path">/now</span>
        </div>
        <div class="inc-status inc-status--ok" role="cell">Operational</div>
        <div class="inc-uptime" role="cell">100%</div>
      </div>

      <div class="inc-row" role="row">
        <div class="inc-svc-col">
          <div class="inc-svc-name-row"><span class="inc-dot inc-dot--green" aria-hidden="true"></span><span>Projects</span></div>
          <span class="inc-svc-path">/projects</span>
        </div>
        <div class="inc-status inc-status--ok" role="cell">Operational</div>
        <div class="inc-uptime" role="cell">100%</div>
      </div>

      <div class="inc-row" role="row">
        <div class="inc-svc-col">
          <div class="inc-svc-name-row"><span class="inc-dot inc-dot--green" aria-hidden="true"></span><span>Contact</span></div>
          <span class="inc-svc-path">/contact</span>
        </div>
        <div class="inc-status inc-status--ok" role="cell">Operational</div>
        <div class="inc-uptime" role="cell">100%</div>
      </div>

      <!-- Affected row — JS populates id="inc-affected-name" and id="inc-affected-path" -->
      <div class="inc-row inc-row--affected" role="row" aria-current="true">
        <div class="inc-svc-col">
          <div class="inc-svc-name-row">
            <span class="inc-dot inc-dot--red" aria-hidden="true"></span>
            <span id="inc-affected-name">/…</span>
          </div>
          <span class="inc-svc-path" id="inc-affected-path">—</span>
        </div>
        <div class="inc-status inc-status--bad" role="cell">Not found</div>
        <div class="inc-uptime inc-uptime--na" role="cell">—</div>
      </div>

    </div>

    <!-- Incident details panel -->
    <div class="inc-panel">
      <div class="inc-panel-head">
        <div class="inc-incident-id" id="inc-id">INC-……</div>
        <div class="inc-pill">Identified</div>
      </div>

      <div class="inc-grid">
        <div class="inc-grid-label">Detected</div>
        <div class="inc-grid-value" id="inc-detected">—</div>

        <div class="inc-grid-label">Duration</div>
        <div class="inc-grid-value" id="inc-duration" aria-live="polite" aria-atomic="true">0s</div>

        <div class="inc-grid-label">Affect</div>
        <div class="inc-grid-value">1 route · 0 upstream errors</div>

        <div class="inc-grid-label">Severity</div>
        <div class="inc-grid-value">Low — isolated missing route</div>
      </div>

      <div class="inc-divider" aria-hidden="true"></div>

      <div class="inc-rca-label">Root cause</div>
      <p class="inc-rca">
        Route <code id="inc-rca-path">/…</code> has no registered handler.
        The page does not exist and has not existed at any prior point in this deployment.
        No upstream errors detected. All other routes healthy.
        System behavior: expected.
      </p>
    </div>

    <!-- CTAs -->
    <nav class="inc-cta-row" aria-label="Recovery options">
      <a href="/" class="inc-cta inc-cta--primary">← Back home</a>
      <a href="/blog" class="inc-cta inc-cta--secondary">Read the blog</a>
      <a href="/contact" class="inc-cta inc-cta--secondary">Get in touch</a>
    </nav>

    <!-- All-clear note -->
    <div class="inc-all-clear">
      <span class="inc-all-clear-dot" aria-hidden="true"></span>
      All other coreymark.com services are fully operational.
    </div>

  </div>
</Base>

<style>
  /*
   * Uses site global CSS custom properties (--color-bg-primary, etc.) defined in
   * global.css via @theme and [data-theme="light"] — theme toggle works automatically,
   * no local [data-theme="light"] block needed.
   */

  .inc-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 28px 80px;
    font-size: 14px;
    line-height: 1.6;
  }

  /* ── Page header ── */
  .inc-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .inc-breadcrumb {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    font-weight: 500;
  }
  .inc-breadcrumb a {
    color: var(--color-accent-primary);
    text-decoration: none;
  }
  .inc-breadcrumb a:hover { text-decoration: underline; text-underline-offset: 2px; }
  .inc-ts {
    font-size: 12px;
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* ── Status banner ── */
  .inc-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 24px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-left: 3px solid var(--color-accent-secondary);
    border-radius: 6px;
    margin-bottom: 40px;
  }
  .inc-banner-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent-secondary);
    flex-shrink: 0;
    animation: inc-pulse-amber 2s ease-in-out infinite;
  }
  @keyframes inc-pulse-amber {
    0%, 100% { opacity: 0.6; }
    50%       { opacity: 1; }
  }
  .inc-banner-text {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text-primary);
    flex: 1;
  }
  .inc-banner-badge {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-accent-secondary);
    background: color-mix(in srgb, var(--color-accent-secondary) 12%, transparent);
    padding: 3px 10px;
    border-radius: 20px;
    white-space: nowrap;
  }

  /* ── Section label ── */
  .inc-section-label {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    font-weight: 500;
    margin-bottom: 12px;
  }

  /* ── Services table ── */
  .inc-services {
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 32px;
  }
  .inc-services-head {
    display: grid;
    grid-template-columns: 1fr 140px 80px;
    padding: 10px 20px;
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .inc-services-head span {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    font-weight: 500;
  }
  .inc-services-head span:not(:first-child) { text-align: center; }

  .inc-row {
    display: grid;
    grid-template-columns: 1fr 140px 80px;
    align-items: center;
    padding: 13px 20px;
    border-bottom: 1px solid var(--color-border-subtle);
    transition: background 0.15s ease;
  }
  .inc-row:last-child { border-bottom: none; }
  .inc-row:hover { background: var(--color-bg-elevated); }

  .inc-row--affected {
    background: color-mix(in srgb, var(--color-error) 6%, transparent);
    border-left: 2px solid var(--color-error);
    padding-left: 18px;
  }
  .inc-row--affected:hover {
    background: color-mix(in srgb, var(--color-error) 9%, transparent);
  }

  .inc-svc-col { display: flex; flex-direction: column; gap: 2px; }
  .inc-svc-name-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--color-text-primary);
  }
  .inc-svc-path {
    font-size: 12px;
    color: var(--color-text-tertiary);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    margin-left: 18px;
  }

  .inc-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .inc-dot--green { background: var(--color-success); }
  .inc-dot--red   {
    background: var(--color-error);
    animation: inc-pulse-red 1.8s ease-in-out infinite;
  }
  @keyframes inc-pulse-red {
    0%, 100% { opacity: 0.7; }
    50%       { opacity: 1; }
  }

  .inc-status { font-size: 12px; font-weight: 500; text-align: center; }
  .inc-status--ok  { color: var(--color-success); }
  .inc-status--bad { color: var(--color-error); }

  .inc-uptime { font-size: 12px; color: var(--color-text-tertiary); text-align: center; font-variant-numeric: tabular-nums; }
  .inc-uptime--na { color: var(--color-error); opacity: 0.6; }

  /* ── Incident panel ── */
  .inc-panel {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: 6px;
    padding: 24px 28px;
    margin-bottom: 40px;
  }
  .inc-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .inc-incident-id {
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--color-accent-primary);
    font-weight: 500;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .inc-pill {
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-accent-secondary);
    background: color-mix(in srgb, var(--color-accent-secondary) 12%, transparent);
    padding: 3px 10px;
    border-radius: 20px;
  }

  .inc-grid {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 10px 24px;
    margin-bottom: 20px;
  }
  .inc-grid-label {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    font-weight: 500;
    padding-top: 1px;
  }
  .inc-grid-value {
    font-size: 13px;
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .inc-divider {
    height: 1px;
    background: var(--color-border-subtle);
    margin: 20px 0;
  }
  .inc-rca-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-tertiary);
    font-weight: 500;
    margin-bottom: 10px;
  }
  .inc-rca {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.75;
  }
  .inc-rca code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
    color: var(--color-text-primary);
    background: var(--color-bg-subtle);
    padding: 1px 6px;
    border-radius: 3px;
  }

  /* ── CTAs ── */
  .inc-cta-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .inc-cta {
    font-size: 12px;
    letter-spacing: 0.08em;
    font-weight: 500;
    text-decoration: none;
    padding: 11px 20px;
    border-radius: 4px;
    transition: all 0.18s ease;
  }
  .inc-cta--primary {
    background: var(--color-accent-primary);
    color: var(--color-bg-primary);
  }
  .inc-cta--primary:hover { opacity: 0.88; }
  .inc-cta--secondary {
    color: var(--color-text-secondary);
    border: 1px solid var(--color-border-subtle);
  }
  .inc-cta--secondary:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }
  .inc-cta:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 3px;
  }

  /* ── All-clear footer ── */
  .inc-all-clear {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px dashed var(--color-border-subtle);
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--color-text-tertiary);
  }
  .inc-all-clear-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .inc-banner-dot, .inc-dot--red { animation: none; opacity: 1; }
  }

  /* ── Mobile ── */
  @media (max-width: 540px) {
    .inc-page { padding: 32px 20px 60px; }
    .inc-services-head,
    .inc-row { grid-template-columns: 1fr 100px 56px; padding: 11px 14px; }
    .inc-row--affected { padding-left: 12px; }
    .inc-panel { padding: 18px; }
    .inc-grid { grid-template-columns: 100px 1fr; }
  }
</style>

<script is:inline>
(() => {
  function incidentId(path) {
    var h = 0x811c9dc5;
    for (var i = 0; i < path.length; i++) {
      h ^= path.charCodeAt(i);
      h = Math.imul(h, 0x01000193);
    }
    return 'INC-' + (h >>> 0).toString(16).toUpperCase().padStart(6, '0').slice(0, 6);
  }

  var path    = window.location.pathname;
  var now     = new Date();
  var started = Date.now();

  document.getElementById('inc-id').textContent           = incidentId(path);
  document.getElementById('inc-affected-name').textContent = path;
  document.getElementById('inc-affected-path').textContent = path;
  document.getElementById('inc-rca-path').textContent      = path;

  var fmt = new Intl.DateTimeFormat('en-US', {
    weekday: 'short', year: 'numeric', month: 'short', day: 'numeric',
    hour: '2-digit', minute: '2-digit', second: '2-digit',
    timeZoneName: 'short', hour12: false,
  });
  var ts = fmt.format(now);
  document.getElementById('inc-detected').textContent  = ts;
  document.getElementById('inc-page-ts').textContent   = ts;

  function tick() {
    var e = Math.floor((Date.now() - started) / 1000);
    var m = Math.floor(e / 60);
    var s = e % 60;
    document.getElementById('inc-duration').textContent = m > 0 ? m + 'm ' + s + 's' : s + 's';
  }
  tick();
  setInterval(tick, 1000);
})();
</script>
