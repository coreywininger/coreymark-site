---
import Base from '../layouts/Base.astro';

const folders = [
  { href: '/blog/', label: 'writing/', color: 'cyan' },
  { href: '/lab/', label: 'lab/', color: 'green' },
  { href: '/projects/', label: 'projects/', color: 'yellow' },
  { href: '/now/', label: 'now', color: 'magenta' },
  { href: '/about/', label: 'about', color: 'blue' },
  { href: '/contact/', label: 'contact', color: 'text' },
];
---

<Base title="404 — Page Not Found" noindex={true}>
  <div class="nf" data-not-found>
    <div class="nf-bg" aria-hidden="true">
      <div class="grid-bg"></div>
      <div class="blob glow"></div>
    </div>
    <div class="nf-inner">
      <section class="term" aria-labelledby="nf-h">
        <div class="term-strip" aria-hidden="true"><span>corey@coreymark: ~</span><span class="exit">exit 404</span></div>
        <div class="term-body">
          <p class="line" aria-hidden="true"><span class="user">corey@coreymark</span>:<span class="path">~</span>$ <span class="typed">cd <span data-missing-path>/this-page</span></span></p>
          <p class="line err" aria-hidden="true">bash: cd: <span data-missing-path>/this-page</span>: No such file or directory</p>
          <p class="line" aria-hidden="true"><span class="user">corey@coreymark</span>:<span class="path">~</span>$ <span class="typed">ls</span></p>
          <nav class="ls" aria-label="Sections" data-not-found-links>
            {folders.map((f) => (
              <a href={f.href} style={`--c: var(--${f.color})`}>{f.label}</a>
            ))}
          </nav>
          <p class="line" aria-hidden="true"><span class="user">corey@coreymark</span>:<span class="path">~</span>$ <span class="cursor"></span></p>
        </div>
      </section>

      <h1 id="nf-h">That page doesn't exist.</h1>
      <p class="sub">The link may be old or mistyped. Pick a folder above, search the site, or head home.</p>
      <div class="actions">
        <a class="btn-primary big" href="/" data-not-found-home>Go home</a>
        <button type="button" class="btn-ghost big" data-open-search>Search the site</button>
      </div>
    </div>
  </div>
</Base>

<style>
  .nf { position: relative; overflow: hidden; min-height: 78vh; display: flex; align-items: center; }
  .nf-bg { position: absolute; inset: 0; pointer-events: none; }
  .nf-bg .grid-bg { position: absolute; inset: 0; }
  .glow { width: 520px; height: 520px; left: 30%; top: -200px; background: var(--red); }
  .nf-inner { position: relative; max-width: 860px; width: 100%; margin: 0 auto; padding: 72px 32px 0; }

  .term {
    border: 1px solid var(--line2);
    border-radius: 16px;
    overflow: hidden;
    background: var(--bg);
    box-shadow: 0 40px 100px -40px rgba(0, 0, 0, 0.7);
  }
  .term-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text3);
  }
  .exit { color: var(--red); }
  .term-body { padding: 28px; font-family: var(--font-mono); font-size: 16px; line-height: 1.9; }
  .line { margin: 0; color: var(--text3); overflow-wrap: anywhere; }
  .user { color: var(--green); }
  .path { color: var(--blue); }
  .typed { color: var(--text); }
  .err { color: var(--red); }
  .ls { display: flex; flex-wrap: wrap; gap: 0 22px; margin: 0 0 6px; }
  .ls a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c);
    text-decoration: underline transparent;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
    transition: text-decoration-color 200ms ease;
  }
  .ls a:hover { text-decoration-color: currentColor; }

  h1 { margin: 36px 0 10px; font-size: 40px; font-weight: 700; letter-spacing: -0.02em; }
  .sub { margin: 0 0 24px; font-size: 18px; color: var(--text2); max-width: 52ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .big { min-height: 48px; padding: 0 20px; font-family: inherit; font-size: inherit; }
  .btn-ghost.big { font-weight: 500; }

  @media (max-width: 560px) {
    .nf-inner { padding: 40px 16px 0; }
    .term-body { padding: 18px; font-size: 14px; }
    h1 { font-size: 32px; }
  }
</style>

<script>
  // Show the path that was actually requested (text only).
  const path = window.location.pathname;
  if (path && path !== '/404' && path !== '/404/' && path !== '/404.html') {
    document.querySelectorAll('[data-missing-path]').forEach((el) => {
      el.textContent = path.length > 80 ? `${path.slice(0, 80)}…` : path;
    });
  }
</script>
