---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { PILLAR_META, type Pillar } from '../../content.config';
import { publishedOnly, sortByPubDateDesc } from '../../lib/content';

const allPosts = await getCollection('blog', publishedOnly);
const posts = sortByPubDateDesc(allPosts);

const pillarOrder: Pillar[] = ['ops', 'business', 'ai', 'cloud', 'personal'];
const pillarCounts = pillarOrder.reduce<Record<string, number>>(
  (acc, p) => {
    acc[p] = posts.filter((post) => post.data.pillar === p).length;
    return acc;
  },
  {},
);
---

<Base
  title="Blog"
  description="Writing on IT operations, translating tech to the business, AI for IT, and hybrid cloud."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent-primary">
        Blog
      </p>
      <h1 class="mb-4 text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
        Field notes, not thought leadership.
      </h1>
      <p class="max-w-2xl text-lg text-text-secondary">
        Four pillars plus a personal lane. Filter below.
      </p>
    </header>

    <div class="mb-6">
      <input
        type="text"
        id="blog-search-input"
        placeholder="Search posts…"
        autocomplete="off"
        class="w-full rounded-lg border border-border-subtle bg-bg-elevated px-3 py-2 text-sm text-text-primary placeholder:text-text-tertiary focus:border-accent-primary focus:outline-none transition-colors"
      />
    </div>

    <nav aria-label="Filter by pillar" class="mb-8">
      <ul class="flex flex-wrap gap-2 text-sm" data-pillar-filters>
        <li>
          <button
            type="button"
            data-filter="all"
            aria-pressed="true"
            class="rounded-full border border-accent-primary bg-accent-primary px-3 py-1.5 font-semibold text-bg-primary transition-colors"
          >
            All · {posts.length}
          </button>
        </li>
        {pillarOrder.map((p) => (
          <li>
            <button
              type="button"
              data-filter={p}
              aria-pressed="false"
              class="rounded-full border border-border-subtle px-3 py-1.5 text-text-secondary transition-colors hover:border-accent-primary hover:text-accent-primary"
            >
              {PILLAR_META[p].label} · {pillarCounts[p]}
            </button>
          </li>
        ))}
      </ul>
    </nav>

    {posts.length === 0 ? (
      <p class="text-text-secondary">
        Nothing here yet. The first posts land at soft-launch.
      </p>
    ) : (
      <div class="grid gap-5 md:grid-cols-2" data-post-list>
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    )}
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(
    '[data-pillar-filters] [data-filter]',
  );
  const cards = document.querySelectorAll<HTMLElement>(
    '[data-post-list] [data-pillar]',
  );
  const searchInput = document.getElementById('blog-search-input') as HTMLInputElement | null;

  let activeFilter = 'all';
  let searchQuery = '';

  const setActive = (target: HTMLButtonElement) => {
    buttons.forEach((b) => {
      const active = b === target;
      b.setAttribute('aria-pressed', String(active));
      b.classList.toggle('bg-accent-primary', active);
      b.classList.toggle('border-accent-primary', active);
      b.classList.toggle('text-bg-primary', active);
      b.classList.toggle('font-semibold', active);
      b.classList.toggle('border-border-subtle', !active);
      b.classList.toggle('text-text-secondary', !active);
    });
  };

  function applyFilters() {
    const q = searchQuery.toLowerCase().trim();
    cards.forEach((card) => {
      const pillar = card.dataset.pillar ?? '';
      const text = (card.getAttribute('data-search-text') ?? '').toLowerCase();
      const pillarMatch = activeFilter === 'all' || pillar === activeFilter;
      const searchMatch = !q || text.includes(q);
      card.hidden = !(pillarMatch && searchMatch);
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = button.dataset.filter ?? 'all';
      setActive(button);
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', () => {
    searchQuery = searchInput.value;
    applyFilters();
  });
</script>
