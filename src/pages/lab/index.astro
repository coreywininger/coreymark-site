---
import Base from '../../layouts/Base.astro';
import LabToolCard from '../../components/LabToolCard.astro';
import { disciplines, toolsByDiscipline } from '../../data/lab-tools';

const populated = disciplines
  .map((d) => ({ ...d, tools: toolsByDiscipline(d.id) }))
  .filter((d) => d.tools.length > 0);
---

<Base
  title="Lab"
  description="Small, focused tools I've built for everyday IT work. Networking, systems, security, DevOps, and cloud utilities — all client-side, all free."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <header class="mb-12">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent-primary">
        Lab
      </p>
      <h1 class="mb-4 text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
        Small tools, sharp edges.
      </h1>
      <p class="max-w-2xl text-lg text-text-secondary">
        Focused IT utilities I've built for everyday work — single-purpose,
        fast, free, and entirely client-side. Bookmark what helps; ignore
        what doesn't.
      </p>
    </header>

    {populated.map((d) => (
      <section class="mb-14" data-lab-section={d.id}>
        <header class="mb-5">
          <h2 class="text-2xl font-semibold leading-tight tracking-tight">
            {d.label}
          </h2>
          <p class="mt-1 text-sm text-text-secondary">{d.description}</p>
        </header>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {d.tools.map((tool) => <LabToolCard tool={tool} />)}
        </div>
      </section>
    ))}
  </section>
</Base>
