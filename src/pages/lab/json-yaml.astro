function loadSample(key) {
  var sample = SAMPLES[key];
  if (!sample) return;
  var chips = document.querySelectorAll('.jy-widget .chip');
  chips.forEach(function(c) {
    if ((c.getAttribute('onclick') || '').indexOf("'" + key + "'") !== -1) flashChip(c);
  });
  document.getElementById('inputArea').value = sample.text;
  if (sample.format === 'json') setMode('json2yaml');
  else setMode('yaml2json');
  triggerRender();
}

loadFromUrl();
if (document.getElementById('inputArea').value) triggerRender();
