---
import LabToolLayout from '../../layouts/LabToolLayout.astro';

const description =
  'Convert between JSON and YAML in your browser. Auto-detects the input and handles Kubernetes, Ansible and GitHub Actions files. Nothing is uploaded.';
---

<LabToolLayout slug="json-yaml" description={description} note="auto-detects input">
  <Fragment slot="intro">Paste JSON or YAML — auto-detects which one you gave it and outputs the other. Handles K8s manifests, Ansible playbooks, and GitHub Actions workflows. 100% client-side: nothing leaves your browser.</Fragment>

    <div class="lab-tool jy-widget py-4">

      <h2 class="sr-only">JSON to YAML and YAML to JSON converter. Auto-detects input format. Supports K8s manifests, Ansible playbooks, GitHub Actions workflows, and Helm values. Indent control, YAML schema selection, flow style toggle, and sample chips for common DevOps formats.</h2>

      <div class="mode-bar">
        <label>Direction:</label>
        <div class="mode-seg" role="group" aria-label="Conversion direction">
          <button id="btnAuto"      class="active" onclick="setMode('auto')">Auto-detect</button>
          <button id="btnJson2Yaml"               onclick="setMode('json2yaml')">JSON → YAML</button>
          <button id="btnYaml2Json"               onclick="setMode('yaml2json')">YAML → JSON</button>
        </div>
        <span id="detectBadge" class="detect-badge" aria-live="polite"></span>
      </div>

      <div class="chip-row-label">Load a sample:</div>
      <div class="chip-row" role="list">
        <button class="chip" role="listitem" onclick="loadSample('k8s')"     aria-label="Load Kubernetes Deployment sample">K8s Deployment</button>
        <button class="chip" role="listitem" onclick="loadSample('simple')"  aria-label="Load simple JSON sample">Simple JSON</button>
        <button class="chip" role="listitem" onclick="loadSample('nested')"  aria-label="Load nested config sample">Nested config</button>
        <button class="chip" role="listitem" onclick="loadSample('gha')"     aria-label="Load GitHub Actions step sample">GitHub Actions step</button>
        <button class="chip" role="listitem" onclick="loadSample('ansible')" aria-label="Load Ansible task sample">Ansible task</button>
      </div>

      <div class="panes">

        <div class="pane" id="inputPane" role="region" aria-label="Input pane">
          <div class="pane-header">
            <div class="pane-header-left">
              <span class="pane-format-label" id="inputFormatLabel">INPUT</span>
              <span class="pane-line-count" id="inputLineCount" aria-live="polite"></span>
            </div>
            <div class="pane-header-actions">
              <button class="icon-btn" id="clearBtn" onclick="clearInput()" title="Clear input" aria-label="Clear input">✕ Clear</button>
            </div>
          </div>
          <textarea
            id="inputArea"
            spellcheck="false"
            autocorrect="off"
            autocapitalize="off"
            placeholder="Paste JSON or YAML here…"
            aria-label="Input JSON or YAML"
            oninput="scheduleRender()"
          ></textarea>
          <div class="pane-error" id="inputError" hidden aria-live="assertive"></div>
        </div>

        <div class="pane-center" aria-label="Controls">
          <button class="center-btn" id="swapBtn" onclick="swapPanes()" title="Swap input and output" aria-label="Swap input and output">⇄</button>
          <button class="center-btn primary" id="convertBtn" onclick="triggerRender()" title="Convert now" aria-label="Convert now">▶</button>
        </div>

        <div class="pane" id="outputPane" role="region" aria-label="Output pane">
          <div class="pane-header">
            <div class="pane-header-left">
              <span class="pane-format-label" id="outputFormatLabel">OUTPUT</span>
              <span class="pane-line-count" id="outputLineCount" aria-live="polite"></span>
            </div>
            <div class="pane-header-actions">
              <button class="icon-btn" id="copyBtn" onclick="copyOutput()" title="Copy output" aria-label="Copy output" disabled>⎘ Copy</button>
              <button class="icon-btn" id="downloadBtn" onclick="downloadOutput()" title="Download output file" aria-label="Download output as file" disabled>↓ Save</button>
            </div>
          </div>
          <div id="outputPlaceholder" class="output-placeholder" aria-hidden="true">
            Output will appear here
          </div>
          <textarea
            id="outputArea"
            readonly
            spellcheck="false"
            aria-label="Converted output"
            hidden
          ></textarea>
        </div>

      </div>

      <div class="options-bar" role="group" aria-label="Conversion options">

        <div class="opt-group">
          <label>Indent</label>
          <div class="opt-seg" role="group" aria-label="Indentation">
            <button id="indent2" class="active" onclick="setOpt('indent', 2)">2 spaces</button>
            <button id="indent4"               onclick="setOpt('indent', 4)">4 spaces</button>
          </div>
        </div>

        <div class="opt-group">
          <div class="tooltip-wrap">
            <label>YAML schema</label>
            <span class="tooltip-icon" tabindex="0" aria-label="Schema explanation">?
              <span class="tooltip-text">
                <strong>JSON_SCHEMA (safe):</strong> Only JSON types — prevents YAML 1.1 traps where <code>yes</code>/<code>no</code>/<code>on</code>/<code>off</code> become booleans.<br /><br />
                <strong>DEFAULT_SCHEMA (permissive):</strong> Full YAML 1.1 — <code>yes</code>, <code>on</code>, <code>true</code> all parse as boolean <code>true</code>.
              </span>
            </span>
          </div>
          <div class="opt-seg" role="group" aria-label="YAML schema mode">
            <button id="schemaJson"    class="active" onclick="setOpt('schema', 'json')">JSON_SCHEMA</button>
            <button id="schemaDefault"             onclick="setOpt('schema', 'default')">DEFAULT</button>
          </div>
        </div>

        <div class="opt-group">
          <label>JSON output</label>
          <div class="opt-seg" role="group" aria-label="JSON output style">
            <button id="jsonPretty"  class="active" onclick="setOpt('jsonStyle', 'pretty')">Pretty</button>
            <button id="jsonCompact"               onclick="setOpt('jsonStyle', 'compact')">Compact</button>
          </div>
        </div>

        <div class="opt-group">
          <label>YAML flow style</label>
          <div class="opt-seg" role="group" aria-label="YAML flow style">
            <button id="yamlBlock" class="active" onclick="setOpt('yamlFlow', false)">Block</button>
            <button id="yamlFlow"               onclick="setOpt('yamlFlow', true)">Flow</button>
          </div>
        </div>

      </div>

      <details class="pitfalls">
        <summary>YAML gotchas you will hit in production</summary>
        <div class="pitfalls-body">
          <div class="pitfall-item">
            <strong>YAML 1.1 booleans</strong>
            In the DEFAULT schema, <code>yes</code>, <code>no</code>, <code>on</code>, <code>off</code>, <code>true</code>, and <code>false</code> all parse as boolean values. A config value of <code>on</code> silently becomes <code>true</code> — this breaks Docker Compose files and Ansible vars constantly. Fix: quote the string (<code>"on"</code>) or switch to JSON_SCHEMA mode above.
          </div>
          <div class="pitfall-item">
            <strong>Multiline strings: <code>|</code> vs <code>&gt;</code></strong>
            <code>|</code> (literal block scalar) preserves newlines exactly. <code>&gt;</code> (folded scalar) collapses newlines into spaces — useful for long prose but will break shell scripts or SQL embedded in YAML.
          </div>
          <div class="pitfall-item">
            <strong>Indentation is structural — tabs not allowed</strong>
            YAML uses spaces only for nesting. A single tab anywhere in the file is a parse error. Most editors auto-insert tabs in code blocks — always verify with <code>cat -A</code> or your editor's whitespace display.
          </div>
          <div class="pitfall-item">
            <strong>Duplicate keys</strong>
            YAML technically forbids duplicate keys, but most parsers silently keep the <em>last</em> value. JSON also forbids them. This converter uses js-yaml which follows the spec.
          </div>
          <div class="pitfall-item">
            <strong>Octal and sexagesimal literals (YAML 1.1)</strong>
            In DEFAULT schema, <code>010</code> parses as octal 8, and <code>1:30</code> parses as 90 (sexagesimal). Quote any numeric string starting with <code>0</code> or containing colons. JSON_SCHEMA mode avoids this entirely.
          </div>
        </div>
      </details>

    </div>

    <div slot="reference" class="prose max-w-none" data-tool-about>
        <p><strong>What it does.</strong> Converts between JSON and YAML instantly. Paste either format — the tool detects which one you gave it and outputs the other. Auto-detect works by checking whether the input starts with <code>{'{'}</code> or <code>[</code> (JSON) or begins with YAML structure. Override detection with the explicit direction controls if needed.</p>
        <p>Handles real-world DevOps content: K8s manifests, Helm values, Ansible playbooks, GitHub Actions workflows, Terraform variable files.</p>
        <p><strong>Schema control.</strong> JSON_SCHEMA mode avoids YAML 1.1's boolean gotcha where <code>yes</code>, <code>no</code>, <code>on</code>, <code>off</code> all parse as booleans. DEFAULT_SCHEMA is permissive (matches what most YAML parsers do in the wild). Indent, flow style, and output formatting options included. Download the result as a properly-named <code>.json</code> or <code>.yaml</code> file.</p>
        <p><strong>What's not included.</strong> No YAML anchors/aliases editor — parsed and serialized correctly, but no visual alias management. No JSON Schema validation — conversion only. No multi-document YAML (the <code>---</code> separator for multiple documents in one file).</p>
        <p><strong>Privacy note:</strong> all conversion happens entirely in your browser via the js-yaml library, which is bundled with the page. Nothing you paste ever leaves the page.</p>
    </div>


<style is:global>
  .jy-widget {
    --jy-bg-secondary: var(--color-bg-elevated);
    --jy-bg-tertiary: var(--color-bg-subtle);
    --jy-bg-danger: color-mix(in srgb, var(--color-error) 12%, transparent);
    --jy-text-muted: var(--color-text-tertiary);
    --jy-text-danger: var(--color-error);
    --jy-text-success: var(--color-success);
    --jy-text-warn: var(--color-accent-secondary);
    --jy-border: var(--color-border-subtle);
    --jy-accent: var(--color-accent-primary);
    --jy-accent-2: var(--color-accent-secondary);
    --jy-radius: 10px;
    --jy-mono: var(--font-mono);
  }
  .jy-widget *, .jy-widget *::before, .jy-widget *::after { box-sizing: border-box; }
  .jy-widget [hidden] { display: none !important; }

  .jy-widget .mode-bar {
    display: flex; align-items: center; gap: 10px;
    margin-bottom: 16px; flex-wrap: wrap;
  }
  .jy-widget .mode-bar label { font-size: 13px; color: var(--color-text-secondary); }
  .jy-widget .mode-seg {
    display: flex; border: 1px solid var(--jy-border); border-radius: 7px; overflow: hidden;
  }
  .jy-widget .mode-seg button {
    background: transparent; border: none; border-right: 1px solid var(--jy-border);
    color: var(--color-text-secondary); padding: 5px 14px; font: inherit; font-size: 13px;
    cursor: pointer; transition: background 0.12s, color 0.12s; min-height: 30px;
  }
  .jy-widget .mode-seg button:last-child { border-right: none; }
  .jy-widget .mode-seg button.active { background: var(--jy-accent); color: var(--bg); font-weight: 600; }
  .jy-widget .mode-seg button:hover:not(.active) { background: var(--jy-bg-tertiary); color: var(--color-text-primary); }
  .jy-widget .mode-seg button:focus-visible { outline: 2px solid var(--jy-accent); outline-offset: 2px; }

  .jy-widget .detect-badge {
    font-size: 12px; padding: 3px 9px; border-radius: 100px;
    background: var(--jy-bg-tertiary); border: 1px solid var(--jy-border); color: var(--color-text-secondary);
  }
  .jy-widget .detect-badge.json { border-color: var(--jy-accent-2); color: var(--jy-accent-2); }
  .jy-widget .detect-badge.yaml { border-color: var(--jy-accent); color: var(--jy-accent); }

  .jy-widget .chip-row-label {
    font-size: 12px; color: var(--jy-text-muted); text-transform: uppercase;
    letter-spacing: 0.06em; margin-bottom: 6px;
  }
  .jy-widget .chip-row {
    display: flex; flex-wrap: wrap; gap: 6px; min-height: 34px; margin-bottom: 20px;
  }
  .jy-widget .chip {
    display: inline-flex; align-items: center; gap: 5px; padding: 4px 12px;
    border: 1px solid var(--jy-border); border-radius: 100px; background: var(--jy-bg-secondary);
    color: var(--color-text-secondary); font: inherit; font-size: 13px;
    cursor: pointer; transition: border-color 0.12s, color 0.12s; min-height: 28px;
  }
  .jy-widget .chip:hover { border-color: var(--jy-accent); color: var(--color-text-primary); }
  .jy-widget .chip:focus-visible { outline: 2px solid var(--jy-accent); outline-offset: 2px; }
  @keyframes chipFlash {
    0%   { background: var(--jy-accent); color: var(--bg); border-color: var(--jy-accent); }
    100% { background: var(--jy-bg-secondary); }
  }
  .jy-widget .chip.chip-flash { animation: chipFlash 140ms ease-out forwards; }

  .jy-widget .panes {
    display: grid; grid-template-columns: 1fr 52px 1fr;
    gap: 0; margin-bottom: 18px; align-items: start;
  }
  .jy-widget .pane {
    border: 1px solid var(--jy-border); border-radius: var(--jy-radius);
    background: var(--jy-bg-secondary); display: flex; flex-direction: column; min-height: 380px;
  }
  .jy-widget .pane.error-state { border-color: var(--jy-text-danger); }
  .jy-widget .pane-header {
    display: flex; align-items: center; justify-content: space-between; gap: 8px;
    padding: 10px 14px 9px; border-bottom: 1px solid var(--jy-border);
    background: var(--jy-bg-tertiary); border-radius: var(--jy-radius) var(--jy-radius) 0 0; flex-shrink: 0;
  }
  .jy-widget .pane-header-left { display: flex; align-items: center; gap: 8px; }
  .jy-widget .pane-format-label {
    font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    padding: 2px 8px; border-radius: 5px; background: var(--jy-bg-secondary);
  }
  .jy-widget .pane-format-label.json { color: var(--jy-accent-2); }
  .jy-widget .pane-format-label.yaml { color: var(--jy-accent); }
  .jy-widget .pane-line-count { font-size: 12px; color: var(--jy-text-muted); }
  .jy-widget .pane-header-actions { display: flex; gap: 6px; }
  .jy-widget .icon-btn {
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent; border: 1px solid var(--jy-border); color: var(--color-text-secondary);
    border-radius: 6px; padding: 4px 8px; font: inherit; font-size: 12px;
    cursor: pointer; gap: 4px; min-height: 28px; min-width: 28px;
    transition: border-color 0.1s, color 0.1s;
  }
  .jy-widget .icon-btn:hover { border-color: var(--jy-accent); color: var(--jy-accent); }
  .jy-widget .icon-btn:focus-visible { outline: 2px solid var(--jy-accent); outline-offset: 2px; }
  .jy-widget .icon-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  .jy-widget .pane textarea {
    flex: 1; background: transparent; border: none; outline: none; resize: none;
    color: var(--color-text-primary); font-family: var(--jy-mono); font-size: 13px;
    line-height: 1.65; padding: 14px; width: 100%; min-height: 340px;
  }
  .jy-widget .pane textarea::placeholder { color: var(--jy-text-muted); }
  .jy-widget .pane textarea[readonly] { cursor: default; color: var(--color-text-secondary); }
  .jy-widget .pane-error {
    font-size: 12px; color: var(--jy-text-danger); padding: 6px 14px 10px;
    font-family: var(--jy-mono); flex-shrink: 0;
  }
  .jy-widget .output-placeholder {
    flex: 1; display: flex; align-items: center; justify-content: center;
    color: var(--jy-text-muted); font-size: 14px; padding: 20px; text-align: center;
  }

  .jy-widget .pane-center {
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 10px; padding: 0 4px; min-height: 380px;
  }
  .jy-widget .center-btn {
    display: flex; align-items: center; justify-content: center;
    background: var(--jy-bg-tertiary); border: 1px solid var(--jy-border);
    color: var(--color-text-primary); border-radius: 8px; padding: 0;
    width: 40px; height: 40px; font: inherit; font-size: 15px;
    cursor: pointer; transition: background 0.1s, border-color 0.1s;
  }
  .jy-widget .center-btn:hover { background: var(--jy-accent); border-color: var(--jy-accent); color: var(--bg); }
  .jy-widget .center-btn:focus-visible { outline: 2px solid var(--jy-accent); outline-offset: 2px; }
  .jy-widget .center-btn.primary {
    background: var(--jy-accent); border-color: var(--jy-accent); color: var(--bg);
    width: 40px; height: 44px; font-size: 13px; font-weight: 600;
  }
  .jy-widget .center-btn.primary:hover { opacity: 0.88; }
  .jy-widget .center-btn.primary:disabled,
  .jy-widget .center-btn.busy { opacity: 0.5; cursor: not-allowed; }

  .jy-widget .options-bar {
    display: flex; flex-wrap: wrap; gap: 20px; align-items: flex-end;
    padding: 14px 18px; background: var(--jy-bg-secondary);
    border: 1px solid var(--jy-border); border-radius: var(--jy-radius);
    margin-bottom: 20px; font-size: 13px;
  }
  .jy-widget .opt-group { display: flex; flex-direction: column; gap: 4px; }
  .jy-widget .opt-group label {
    font-size: 11px; color: var(--jy-text-muted); text-transform: uppercase; letter-spacing: 0.06em;
  }
  .jy-widget .opt-seg {
    display: flex; border: 1px solid var(--jy-border); border-radius: 6px; overflow: hidden;
  }
  .jy-widget .opt-seg button {
    background: transparent; border: none; border-right: 1px solid var(--jy-border);
    color: var(--color-text-secondary); padding: 4px 11px; font: inherit; font-size: 12px;
    cursor: pointer; transition: background 0.1s, color 0.1s; min-height: 28px;
  }
  .jy-widget .opt-seg button:last-child { border-right: none; }
  .jy-widget .opt-seg button.active { background: var(--jy-accent); color: var(--bg); font-weight: 600; }
  .jy-widget .opt-seg button:hover:not(.active) { background: var(--jy-bg-tertiary); color: var(--color-text-primary); }
  .jy-widget .opt-seg button:focus-visible { outline: 2px solid var(--jy-accent); outline-offset: 2px; }

  .jy-widget .tooltip-wrap { position: relative; display: inline-flex; align-items: center; gap: 4px; }
  .jy-widget .tooltip-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 16px; height: 16px; background: var(--jy-bg-tertiary); border: 1px solid var(--jy-border);
    border-radius: 50%; font-size: 10px; color: var(--jy-text-muted); cursor: help;
  }
  .jy-widget .tooltip-text {
    display: none; position: absolute; bottom: calc(100% + 6px); left: 0; width: 260px;
    background: var(--jy-bg-tertiary); border: 1px solid var(--jy-border); border-radius: 8px;
    padding: 10px 12px; font-size: 12px; color: var(--color-text-secondary);
    line-height: 1.5; z-index: 10; pointer-events: none;
  }
  .jy-widget .tooltip-wrap:hover .tooltip-text,
  .jy-widget .tooltip-wrap:focus-within .tooltip-text { display: block; }

  .jy-widget details.pitfalls {
    border: 1px solid var(--jy-border); border-radius: var(--jy-radius);
    margin-bottom: 20px; background: var(--jy-bg-secondary);
  }
  .jy-widget details.pitfalls summary {
    padding: 12px 18px; cursor: pointer; font-weight: 600; font-size: 14px;
    color: var(--color-text-primary); list-style: none;
    display: flex; align-items: center; justify-content: space-between; user-select: none;
  }
  .jy-widget details.pitfalls summary::-webkit-details-marker { display: none; }
  .jy-widget details.pitfalls summary::after {
    content: "›"; font-size: 18px; color: var(--jy-text-muted); transition: transform 0.15s;
  }
  .jy-widget details.pitfalls[open] summary::after { transform: rotate(90deg); }
  .jy-widget details.pitfalls summary:hover { color: var(--jy-accent); }
  .jy-widget details.pitfalls summary:focus-visible {
    outline: 2px solid var(--jy-accent); outline-offset: 2px; border-radius: var(--jy-radius);
  }
  .jy-widget .pitfalls-body { padding: 0 18px 16px; border-top: 1px solid var(--jy-border); }
  .jy-widget .pitfall-item {
    padding: 12px 0; border-bottom: 1px solid var(--jy-border); font-size: 13px; line-height: 1.6;
  }
  .jy-widget .pitfall-item:last-child { border-bottom: none; }
  .jy-widget .pitfall-item strong { color: var(--jy-accent-2); display: block; margin-bottom: 3px; }
  .jy-widget code {
    font-family: var(--jy-mono); font-size: 0.9em; background: var(--jy-bg-tertiary);
    border: 1px solid var(--jy-border); padding: 1px 5px; border-radius: 4px;
    color: var(--color-text-primary);
  }

  @media (max-width: 700px) {
    .jy-widget .panes { grid-template-columns: 1fr; grid-template-rows: auto auto auto; }
    .jy-widget .pane-center { flex-direction: row; min-height: unset; padding: 10px 0; justify-content: center; }
    .jy-widget .pane { min-height: 220px; }
    .jy-widget .pane textarea { min-height: 180px; }
    .jy-widget .options-bar { gap: 12px; }
  }
</style>

{/* js-yaml comes from the npm package and is bundled by Astro. It used to be
    pasted inline, and that copy had literal U+2028 / U+2029 characters inside
    a regex, which is a syntax error. Never paste library code into the page. */}
<script>
  import * as jsyaml from 'js-yaml';

  // The converter below is a classic inline script (its buttons use onclick
  // handlers), so it reads the library from window. Module scripts run after
  // inline ones: render again once the library is available.
  const w = window as unknown as { jsyaml: typeof jsyaml; triggerRender?: () => void };
  w.jsyaml = jsyaml;
  document.documentElement.setAttribute('data-jsyaml-ready', '');
  const input = document.getElementById('inputArea') as HTMLTextAreaElement | null;
  if (input?.value) w.triggerRender?.();
</script>

<script is:inline>
var jyOpts = {
  mode:      'auto',
  indent:    2,
  schema:    'json',
  jsonStyle: 'pretty',
  yamlFlow:  false,
};

var jyRendering = false;
var jyPending = false;
var jyDebounce = null;

function scheduleRender() {
  clearTimeout(jyDebounce);
  jyDebounce = setTimeout(jyRender, 300);
}
function triggerRender() {
  clearTimeout(jyDebounce);
  jyRender();
}

function jyRender() {
  if (jyRendering) { jyPending = true; return; }
  jyRendering = true;
  setBusyState(true);
  requestAnimationFrame(function() { setTimeout(function() {
    try { renderImpl(); }
    catch (e) {
      var inErr = document.getElementById('inputError');
      var inPane = document.getElementById('inputPane');
      if (inErr && inPane) {
        inPane.classList.add('error-state');
        inErr.textContent = 'Unexpected error: ' + (e.message || String(e));
        inErr.hidden = false;
      }
    }
    finally {
      jyRendering = false;
      setBusyState(false);
      if (jyPending) { jyPending = false; jyRender(); }
    }
  }, 0); });
}

var jyBusyTimer = null;
function setBusyState(busy) {
  var btn = document.getElementById('convertBtn');
  if (busy) {
    btn.classList.add('busy'); btn.disabled = true;
    jyBusyTimer = setTimeout(function() { if (btn.disabled) btn.title = 'Converting…'; }, 80);
  } else {
    clearTimeout(jyBusyTimer);
    btn.classList.remove('busy'); btn.disabled = false; btn.title = 'Convert now';
  }
}

function flashChip(btn) {
  btn.classList.remove('chip-flash');
  void btn.offsetWidth;
  btn.classList.add('chip-flash');
  setTimeout(function() { btn.classList.remove('chip-flash'); }, 140);
}

function detectFormat(text) {
  var t = text.trim();
  if (!t) return null;
  return (t.charAt(0) === '{' || t.charAt(0) === '[') ? 'json' : 'yaml';
}

function renderImpl() {
  // The library is a bundled module that runs just after this script and
  // re-renders when it is ready. Until the page has finished loading, wait
  // for it rather than flash the "failed to load" message below.
  if (typeof window.jsyaml === 'undefined' && document.readyState !== 'complete') return;
  var jsyaml = window.jsyaml;
  var raw    = document.getElementById('inputArea').value;
  var inErr  = document.getElementById('inputError');
  var inPane = document.getElementById('inputPane');

  var inLines = raw ? raw.split('\n').length : 0;
  document.getElementById('inputLineCount').textContent =
    raw ? (inLines + ' line' + (inLines !== 1 ? 's' : '')) : '';

  inErr.hidden = true; inErr.textContent = '';
  inPane.classList.remove('error-state');

  if (!raw.trim()) { setOutput(null, null); updateDetectBadge(null); pushUrlState(); return; }

  if (typeof jsyaml === 'undefined') {
    inPane.classList.add('error-state');
    inErr.textContent = 'js-yaml library failed to load — reload the page.';
    inErr.hidden = false; setOutput(null, null); return;
  }

  var detected  = detectFormat(raw);
  var direction = jyOpts.mode === 'auto'
    ? (detected === 'json' ? 'json2yaml' : 'yaml2json')
    : jyOpts.mode;

  updateDetectBadge(jyOpts.mode === 'auto' ? detected : null);
  updatePaneLabels(direction);

  try {
    var schema = jyOpts.schema === 'json' ? jsyaml.JSON_SCHEMA : jsyaml.DEFAULT_SCHEMA;
    var outputText;

    if (direction === 'json2yaml') {
      var parsed;
      try { parsed = JSON.parse(raw); }
      catch (e) { throw buildError('JSON parse error', e); }
      outputText = jsyaml.dump(parsed, { indent: jyOpts.indent, flowLevel: jyOpts.yamlFlow ? 0 : -1, schema: schema, lineWidth: -1 });
    } else {
      var parsed;
      try { parsed = jsyaml.load(raw, { schema: schema }); }
      catch (e) { throw buildError('YAML parse error', e); }
      outputText = jyOpts.jsonStyle === 'pretty'
        ? JSON.stringify(parsed, null, jyOpts.indent)
        : JSON.stringify(parsed);
    }

    setOutput(outputText, direction);
    pushUrlState();
  } catch (e) {
    inPane.classList.add('error-state');
    inErr.textContent = e.message || String(e);
    inErr.hidden = false; setOutput(null, null);
  }
}

function buildError(prefix, e) {
  if (e.mark) {
    var line = (e.mark.line || 0) + 1, col = (e.mark.column || 0) + 1;
    return new Error(prefix + ' at line ' + line + ', col ' + col + ': ' + (e.reason || e.message));
  }
  return new Error(prefix + ': ' + (e.message || String(e)));
}

function setOutput(text, direction) {
  var outArea = document.getElementById('outputArea');
  var outPH   = document.getElementById('outputPlaceholder');
  var copyBtn = document.getElementById('copyBtn');
  var dlBtn   = document.getElementById('downloadBtn');
  if (!text) {
    outArea.hidden = true; outPH.hidden = false;
    copyBtn.disabled = true; dlBtn.disabled = true;
    document.getElementById('outputLineCount').textContent = '';
    return;
  }
  outArea.value = text; outArea.hidden = false; outPH.hidden = true;
  copyBtn.disabled = false; dlBtn.disabled = false;
  var outLines = text.split('\n').length;
  document.getElementById('outputLineCount').textContent =
    outLines + ' line' + (outLines !== 1 ? 's' : '');
}

function updatePaneLabels(direction) {
  var inLbl  = document.getElementById('inputFormatLabel');
  var outLbl = document.getElementById('outputFormatLabel');
  if (direction === 'json2yaml') {
    inLbl.textContent = 'JSON'; inLbl.className = 'pane-format-label json';
    outLbl.textContent = 'YAML'; outLbl.className = 'pane-format-label yaml';
  } else {
    inLbl.textContent = 'YAML'; inLbl.className = 'pane-format-label yaml';
    outLbl.textContent = 'JSON'; outLbl.className = 'pane-format-label json';
  }
}

function updateDetectBadge(detected) {
  var badge = document.getElementById('detectBadge');
  if (!detected) { badge.textContent = ''; badge.className = 'detect-badge'; return; }
  badge.textContent = 'Auto-detected: ' + detected.toUpperCase();
  badge.className = 'detect-badge ' + detected;
}

function setMode(mode) {
  jyOpts.mode = mode;
  document.getElementById('btnAuto').classList.toggle('active',      mode === 'auto');
  document.getElementById('btnJson2Yaml').classList.toggle('active', mode === 'json2yaml');
  document.getElementById('btnYaml2Json').classList.toggle('active', mode === 'yaml2json');
  triggerRender();
}

function setOpt(key, val) {
  jyOpts[key] = val;
  if (key === 'indent') {
    document.getElementById('indent2').classList.toggle('active', val === 2);
    document.getElementById('indent4').classList.toggle('active', val === 4);
  }
  if (key === 'schema') {
    document.getElementById('schemaJson').classList.toggle('active',    val === 'json');
    document.getElementById('schemaDefault').classList.toggle('active', val === 'default');
  }
  if (key === 'jsonStyle') {
    document.getElementById('jsonPretty').classList.toggle('active',  val === 'pretty');
    document.getElementById('jsonCompact').classList.toggle('active', val === 'compact');
  }
  if (key === 'yamlFlow') {
    document.getElementById('yamlBlock').classList.toggle('active', !val);
    document.getElementById('yamlFlow').classList.toggle('active',   val);
  }
  triggerRender();
}

function clearInput() { document.getElementById('inputArea').value = ''; triggerRender(); }

function swapPanes() {
  var inArea  = document.getElementById('inputArea');
  var outArea = document.getElementById('outputArea');
  var outText = outArea.hidden ? '' : outArea.value;
  if (!outText) return;
  inArea.value = outText;
  if (jyOpts.mode === 'json2yaml') setMode('yaml2json');
  else if (jyOpts.mode === 'yaml2json') setMode('json2yaml');
  else triggerRender();
}

function copyOutput() {
  var text = document.getElementById('outputArea').value;
  if (!text) return;
  navigator.clipboard.writeText(text).then(function() {
    var btn = document.getElementById('copyBtn');
    var orig = btn.innerHTML;
    btn.innerHTML = '✓ Copied';
    btn.style.color = 'var(--color-success)';
    setTimeout(function() { btn.innerHTML = orig; btn.style.color = ''; }, 1500);
  }).catch(function() {
    var ta = document.getElementById('outputArea');
    ta.removeAttribute('readonly'); ta.select(); document.execCommand('copy'); ta.setAttribute('readonly', '');
  });
}

function downloadOutput() {
  var text = document.getElementById('outputArea').value;
  if (!text) return;
  var outLbl = document.getElementById('outputFormatLabel').textContent.trim().toLowerCase();
  var ext = (outLbl === 'yaml') ? 'yaml' : 'json';
  var blob = new Blob([text], { type: 'text/plain' });
  var url  = URL.createObjectURL(blob);
  var a    = document.createElement('a');
  a.href = url; a.download = 'converted.' + ext;
  document.body.appendChild(a); a.click();
  setTimeout(function() { document.body.removeChild(a); URL.revokeObjectURL(url); }, 200);
}

function pushUrlState() {
  try {
    var raw = document.getElementById('inputArea').value;
    var params = new URLSearchParams();
    if (raw.length <= 800) params.set('input', raw);
    if (jyOpts.mode !== 'auto') params.set('mode', jyOpts.mode);
    if (jyOpts.indent !== 2) params.set('indent', jyOpts.indent);
    var qs = params.toString();
    history.replaceState(null, '', qs ? location.pathname + '?' + qs : location.pathname);
  } catch(_) {}
}

function loadFromUrl() {
  try {
    var params = new URLSearchParams(location.search);
    if (params.has('input')) document.getElementById('inputArea').value = params.get('input');
    if (params.has('mode'))   setMode(params.get('mode'));
    if (params.has('indent')) setOpt('indent', parseInt(params.get('indent'), 10) || 2);
  } catch(_) {}
}

