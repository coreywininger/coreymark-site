      true
    )
  };

  /* ---------- wiring ---------- */
  inputEl.addEventListener('input', scheduleRender);
  document.getElementById('decode-btn').addEventListener('click', scheduleRender);
  document.getElementById('clear-btn').addEventListener('click', function () {
    inputEl.value = '';
    scheduleRender();
  });

  document.getElementById('samples').addEventListener('click', function (e) {
    var b = e.target.closest('.chip');
    if (!b) return;
    flashChip(b);
    var key = b.dataset.sample;
    if (SAMPLES[key]) {
      inputEl.value = SAMPLES[key];
      scheduleRender();
    }
  });

  document.querySelectorAll('.jwt-widget .copy').forEach(function (btn) {
    btn.addEventListener('click', async function () {
      if (!lastDecoded) return;
      var which = btn.dataset.copy;
      var text =
        which === 'header'    ? JSON.stringify(lastDecoded.header, null, 2) :
        which === 'payload'   ? JSON.stringify(lastDecoded.payload, null, 2) :
        which === 'signature' ? lastDecoded.signatureB64 : '';
      try {
        await navigator.clipboard.writeText(text);
        var orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = orig; }, 900);
      } catch (e) {}
    });
  });

  document.getElementById('verify-btn').addEventListener('click', async function () {
    var result = document.getElementById('verify-result');
    if (!lastDecoded) return;
    var alg = lastDecoded.header && lastDecoded.header.alg;
    var secret = document.getElementById('secret-input').value;
    if (!secret) {
      result.className = 'result warn';
      result.textContent = 'Enter a secret first.';
      return;
    }
    result.className = 'result muted';
    result.textContent = 'Verifying…';
    try {
      var ok = await verifyHmac(
        lastDecoded.headerB64, lastDecoded.payloadB64, lastDecoded.signatureB64, secret,
        String(alg).toUpperCase()
      );
      if (ok) { result.className = 'result ok';  result.textContent = '✓ Signature valid — token was signed with this secret.'; }
      else    { result.className = 'result err'; result.textContent = '✗ Signature does not match — wrong secret, or token was tampered with.'; }
    } catch (e) {
      result.className = 'result err';
      result.textContent = 'Verify error: ' + e.message;
    }
  });

  /* boot */
  refreshColored();
})();
</script>
</Base>
