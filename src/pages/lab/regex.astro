    else { copyMatchesBtn.classList.remove('busy'); }
  }

  function flashChip(el) {
    el.classList.remove('chip-flash');
    void el.offsetWidth;
    el.classList.add('chip-flash');
    setTimeout(function () { el.classList.remove('chip-flash'); }, 160);
  }

  function render() {
    if (rendering) { pendingRender = true; return; }
    rendering = true;
