        renderImpl();
        setBusyState(false);
        rendering = false;
        if (pendingRender) { pendingRender = false; render(); }
      }, 0);
    });
  }

  function renderImpl() {
    var patStr = patternInput.value, testStr = testInput.value;
    activeFlagsDisplay.textContent = getActiveFlags();

    var rx = null;
    if (patStr) {
      try {
        rx = buildRegex(patStr);
        patternRow.classList.remove('invalid');
        patternRow.classList.add('valid');
        patternError.textContent = '';
      } catch (e) {
        patternRow.classList.remove('valid');
        patternRow.classList.add('invalid');
        patternError.textContent = '⚠ ' + e.message;
        renderEmpty(testStr, 'invalid');
        return;
      }
    } else {
      patternRow.classList.remove('valid', 'invalid');
      patternError.textContent = '';
      renderEmpty(testStr, 'empty');
      return;
    }

    var statsEl = document.getElementById('testStrStats');
    if (statsEl) {
      if (testStr) {
        var lines = testStr.split('\n').length;
        statsEl.textContent = testStr.length.toLocaleString() + ' chars · ' + lines.toLocaleString() + ' line' + (lines !== 1 ? 's' : '');
      } else { statsEl.textContent = ''; }
    }

    var result = collectMatches(rx, testStr);
    lastMatches = result.matches;

    if (result.timedOut) {
      matchCount.textContent = result.matches.length + '+ (timed out)';
      matchCount.className = 'warn-matches';
      var warn = document.createElement('div');
      warn.className = 'backtrack-warn';
      warn.dataset.testid = 'backtrack-warning';
      warn.textContent = '⚠ Match operation exceeded 500 ms and was stopped — this pattern may cause catastrophic backtracking. Try a shorter test string or simplify nested quantifiers.';
