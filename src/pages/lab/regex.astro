  function pushState() {
    var url = new URL(location.href);
    var p = patternInput.value, f = getActiveFlags(), t = testInput.value.slice(0, 500);
    if (p) url.searchParams.set('pattern', p); else url.searchParams.delete('pattern');
    if (f) url.searchParams.set('flags', f);   else url.searchParams.delete('flags');
    if (t) url.searchParams.set('test', t);    else url.searchParams.delete('test');
    history.replaceState(null, '', url.toString());
  }
  function loadFromURL() {
    var url = new URL(location.href);
    var p = url.searchParams.get('pattern');
    var f = url.searchParams.get('flags');
    var t = url.searchParams.get('test');
    if (p) patternInput.value = p;
    if (f) {
      flagChips.forEach(function (chip) {
        var active = f.includes(chip.dataset.flag);
