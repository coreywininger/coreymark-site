      var existing = document.querySelector('.regex-widget .backtrack-warn');
      if (existing) existing.remove();
      highlightMirror.parentNode.insertBefore(warn, highlightMirror.nextSibling);
      return;
    } else {
      var bw = document.querySelector('.regex-widget .backtrack-warn');
      if (bw) bw.remove();
    }

    renderHighlights(testStr, result.matches);

    if (result.matches.length === 0) {
      matchCount.textContent = 'No matches';
      matchCount.className = 'no-matches';
    } else {
      matchCount.textContent = result.matches.length + (result.matches.length === 1 ? ' match' : ' matches');
      matchCount.className = 'has-matches';
    }

    if (result.matches.length > 0) {
      matchDetailWrap.removeAttribute('hidden');
      matchDetailSummary.textContent = result.matches.length + (result.matches.length === 1 ? ' match' : ' matches') + ' — click to expand';
