---
import Base from '../../layouts/Base.astro';

const title = 'Regex tester';
const description =
  'Test regular expressions live — match highlighting, capture groups, global/case/multiline flags, replace mode, backtracking warnings, presets, and history. 100% client-side.';
---

<Base title={title} description={description}>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-text-tertiary">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-text-primary">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/lab/" class="hover:text-text-primary">Lab</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-text-secondary">Regex tester</li>
      </ol>
    </nav>

    <header class="mb-8">
      <h1 class="mb-3 text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
        Regex tester
      </h1>
      <p class="max-w-2xl text-lg text-text-secondary">
        Live pattern matching, capture group highlighting, and replace preview —
        works offline, nothing leaves your browser.
      </p>
    </header>

    <h2 class="sr-only">
      Regex tester with live match highlighting, capture groups, global/case-insensitive/multiline/dotAll/unicode
      flags, replace mode with backreference preview, backtracking timeout warnings, ten built-in pattern presets,
      and per-browser pattern history.
    </h2>

    <div class="lab-tool regex-widget" data-testid="regex-widget">

      <!-- Presets -->
      <div class="chips-section card">
        <div class="section-label">Presets</div>
        <div class="chips-row" id="presetRow" role="group" aria-label="Pattern presets"></div>
      </div>

      <!-- History -->
      <div class="chips-section card" style="margin-top:-6px">
        <div class="section-label">Recent</div>
        <div class="chips-row" id="historyRow" aria-live="polite" role="group" aria-label="Pattern history"></div>
      </div>

      <!-- Main tool card -->
      <div class="card">

        <!-- Mode toggle -->
        <div class="mode-row" role="group" aria-label="Mode">
          <button class="mode-btn active" id="modeTest" aria-pressed="true">Test</button>
          <button class="mode-btn"        id="modeReplace" aria-pressed="false">Replace</button>
        </div>

        <!-- Pattern input -->
        <div class="section-label">Pattern</div>
        <div class="pattern-row" id="patternRow">
          <span class="pattern-delimiter" aria-hidden="true">/</span>
          <input
            type="text"
            id="patternInput"
            spellcheck="false"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="off"
            placeholder="[a-z]+"
            aria-label="Regular expression pattern"
          />
          <span class="pattern-delimiter right" aria-hidden="true">/</span>
          <div class="pattern-flags-inline">
            <span class="flag-inline-display" id="activeFlagsDisplay" title="Active flags" aria-label="Active flags"></span>
          </div>
          <div class="pattern-actions">
            <button class="icon-btn" id="copyPatternBtn" title="Copy pattern" aria-label="Copy pattern">⎘</button>
          </div>
        </div>
        <div class="pattern-error" id="patternError" role="alert" aria-live="assertive"></div>

        <!-- Flags strip -->
        <div class="flags-row" role="group" aria-label="Regex flags">
          <span class="flags-label">Flags</span>
          <button class="flag-chip active" data-flag="g" data-tip="global — find all matches" tabindex="0">g</button>
          <button class="flag-chip"        data-flag="i" data-tip="case insensitive" tabindex="0">i</button>
          <button class="flag-chip"        data-flag="m" data-tip="multiline (^ and $ match line boundaries)" tabindex="0">m</button>
          <button class="flag-chip"        data-flag="s" data-tip="dotAll — dot matches newlines" tabindex="0">s</button>
          <button class="flag-chip"        data-flag="u" data-tip="unicode — enables \p&#123;&#125; escapes" tabindex="0">u</button>
        </div>

        <!-- Test string -->
        <div class="section-label" style="margin-top:18px; display:flex; align-items:baseline; justify-content:space-between;">
          <span>Test String</span>
          <span id="testStrStats" style="font-size:12px; color:var(--color-text-muted); font-weight:400; letter-spacing:normal; text-transform:none;"></span>
        </div>
        <textarea
          id="testInput"
          spellcheck="false"
          autocorrect="off"
          autocomplete="off"
          placeholder="Paste or type a string to test against..."
          aria-label="Test string"
        ></textarea>

        <!-- Replace mode input (hidden by default) -->
        <div id="replaceSection" data-testid="replace-section" hidden>
          <div class="replace-row">
            <span class="replace-prefix">Replace</span>
            <input
              type="text"
              id="replaceInput"
              spellcheck="false"
              autocorrect="off"
              autocomplete="off"
              placeholder="Replacement — $1 $2 $& for backreferences"
              aria-label="Replacement string"
            />
          </div>
        </div>

        <!-- Highlight mirror -->
        <div class="mirror-wrap">
          <div class="mirror-header">
            <span>Match Highlights</span>
            <div class="mirror-header-right">
              <span id="matchCount" class="no-matches" data-testid="match-count">—</span>
              <button class="icon-btn copy-matches-btn" id="copyMatchesBtn" title="Copy matches as JSON" aria-label="Copy matches as JSON">⎘ matches</button>
            </div>
          </div>
          <div id="highlightMirror" aria-live="polite" aria-label="Highlighted matches"></div>
        </div>

        <!-- Match detail collapsible -->
        <div class="match-detail" id="matchDetailWrap" hidden>
          <details class="match-detail-inner" id="matchDetailEl">
            <summary id="matchDetailSummary">0 matches found</summary>
            <div class="match-detail-body" id="matchDetailBody"></div>
          </details>
        </div>

        <!-- Replace output (hidden in Test mode) -->
        <div id="replaceOutputSection" hidden>
          <div class="replace-output">
            <div class="replace-output-header">
              <span>Result</span>
              <button class="icon-btn" id="copyResultBtn" title="Copy result" aria-label="Copy result">⎘ copy</button>
            </div>
            <div id="replaceOutput" data-testid="replace-output" aria-live="polite"></div>
          </div>
        </div>

      </div><!-- /.card -->

      <!-- Pitfall panel -->
      <details class="pitfall-panel">
        <summary>⚠ Common regex gotchas</summary>
        <div class="pitfall-body">
          <div class="pitfall-item">
            <h3>Catastrophic backtracking</h3>
            <p>Nested quantifiers like <code>(a+)+</code> can cause exponential backtracking — the engine may hang for seconds or minutes on moderately long strings. Test with short strings first; if your pattern requires nesting, consider atomic groups or possessive quantifiers (not supported in JS).</p>
          </div>
          <div class="pitfall-item">
            <h3>Greedy vs. lazy quantifiers</h3>
            <p><code>.+</code> is greedy — it matches as much text as possible, then backtracks. <code>.+?</code> is lazy — it matches as little as possible. This matters enormously when parsing HTML tags or log lines where you want the shortest possible match between delimiters.</p>
          </div>
          <div class="pitfall-item">
            <h3><code>^</code> and <code>$</code> with multiline flag</h3>
            <p>Without the <code>m</code> flag, <code>^</code> matches only the very start of the string and <code>$</code> matches only the very end. With <code>m</code> enabled, they match the start and end of <em>each line</em>.</p>
          </div>
          <div class="pitfall-item">
            <h3>dotAll (<code>s</code> flag)</h3>
            <p>By default, <code>.</code> does NOT match newline characters. If your pattern needs to span multiple lines, enable the <code>s</code> (dotAll) flag. Without it, <code>.*</code> silently stops at line boundaries.</p>
          </div>
          <div class="pitfall-item">
            <h3>Unicode (<code>u</code> flag)</h3>
            <p>Required for emoji and supplementary-plane characters (code points above U+FFFF). Also enables Unicode property escapes like <code>\p&#123;Letter&#125;</code>. Without <code>u</code>, emoji can produce unexpected match lengths.</p>
          </div>
          <div class="pitfall-item">
            <h3>IPv6 regex is never fully correct</h3>
            <p>A regex covering all valid IPv6 forms runs to several hundred characters. The "IPv6 (practical)" preset covers the vast majority of real-world addresses, but will miss edge cases. For validation, use a proper IP parsing library — not regex.</p>
          </div>
        </div>
      </details>

    </div><!-- /.regex-widget -->

    <details class="mt-12 rounded-lg border border-border-subtle bg-bg-elevated p-5">
      <summary class="cursor-pointer text-base font-semibold text-text-primary">
        About this tool
      </summary>
      <div class="prose prose-sm mt-4 max-w-none text-text-secondary">
        <p><strong>What it does.</strong> Tests JavaScript regular expressions in real time with color-coded match highlighting, capture group display, and a collapsible match detail list showing each match value, index range, and group captures.</p>
        <p><strong>Replace mode.</strong> Preview the result of <code>str.replace(rx, template)</code> with full backreference support: <code>$&amp;</code>, <code>$1</code>/<code>$2</code>, <code>$&lt;name&gt;</code> (named groups).</p>
        <p><strong>Safety.</strong> A 500 ms wall-clock budget stops the match loop if it exceeds that threshold — catching catastrophic backtracking before it locks up your tab.</p>
        <p><strong>Presets.</strong> Ten built-in patterns for common IT/ops tasks: email, IPv4, UUID, ISO date, semver, log levels, CIDR v4, IPv6, CIDR v6, and named capture groups.</p>
        <p><strong>History.</strong> The last five patterns are stored in <code>localStorage</code> (key <code>lab-regex-history</code>) as recall chips. Test strings are not saved.</p>
        <p><strong>URL state.</strong> Pattern, active flags, and up to 500 chars of test string are reflected in the URL via <code>replaceState</code> for easy sharing.</p>
        <p><strong>Privacy.</strong> All processing is local — nothing leaves your browser.</p>
      </div>
    </details>

    <div class="mt-8 flex flex-wrap items-center gap-3 border-t border-border-subtle pt-6 text-xs text-text-tertiary">
      <span class="rounded border border-border-subtle bg-bg-subtle px-2 py-0.5">DevOps</span>
      <span>Added 2026-05-12</span>
    </div>
  </section>

<style is:global>
  /* Regex tester — scoped to .regex-widget. Token aliases map prototype var names to site tokens. */
  .regex-widget {
    --color-bg-secondary: var(--color-bg-elevated);
    --color-bg-tertiary: var(--color-bg-subtle);
    --color-bg-danger: color-mix(in srgb, var(--color-error) 12%, transparent);
    --color-text-muted: var(--color-text-tertiary);
    --color-text-danger: var(--color-error);
    --color-text-success: var(--color-success);
    --color-text-warn: var(--color-accent-secondary);
    --color-border-tertiary: var(--color-border-subtle);
    --color-accent: var(--color-accent-primary);
    --color-accent-2: var(--color-accent-secondary);
    --radius: 10px;
    --mono: var(--font-mono, ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace);
    --hl0: rgba(20,184,166,0.30);
    --hl1: rgba(245,158,11,0.30);
    --hl2: rgba(139,92,246,0.30);
    --hl3: rgba(236,72,153,0.30);
    --hl4: rgba(59,130,246,0.30);
    --hl5: rgba(34,197,94,0.30);
    --hl0-border: #14b8a6;
    --hl1-border: #f59e0b;
    --hl2-border: #8b5cf6;
    --hl3-border: #ec4899;
    --hl4-border: #3b82f6;
    --hl5-border: #22c55e;
  }
  html[data-theme="light"] .regex-widget {
    --hl0: rgba(15,118,110,0.18);
    --hl1: rgba(180,83,9,0.18);
    --hl2: rgba(109,40,217,0.18);
    --hl3: rgba(219,39,119,0.18);
    --hl4: rgba(37,99,235,0.18);
    --hl5: rgba(22,163,74,0.18);
    --hl0-border: #0F766E;
    --hl1-border: #B45309;
    --hl2-border: #6d28d9;
    --hl3-border: #db2777;
    --hl4-border: #2563eb;
    --hl5-border: #16a34a;
  }
  .regex-widget [hidden] { display: none !important; }
  .regex-widget *, .regex-widget *::before, .regex-widget *::after { box-sizing: border-box; }

  .regex-widget .card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border-tertiary);
    border-radius: var(--radius);
    padding: 18px 20px;
    margin-bottom: 14px;
  }
  .regex-widget .section-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 10px;
  }
  .regex-widget .pattern-row {
    display: flex;
    align-items: stretch;
    gap: 0;
    border: 1.5px solid var(--color-border-tertiary);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg-tertiary);
    transition: border-color 0.15s;
  }
  .regex-widget .pattern-row:focus-within { border-color: var(--color-accent); }
  .regex-widget .pattern-row.invalid { border-color: var(--color-text-danger) !important; }
  .regex-widget .pattern-row.valid   { border-color: var(--color-text-success) !important; }
  .regex-widget .pattern-delimiter {
    display: flex; align-items: center; justify-content: center;
    padding: 0 10px;
    background: var(--color-bg-tertiary);
    color: var(--color-text-muted);
    font-family: var(--mono);
    font-size: 20px;
    user-select: none;
    pointer-events: none;
    border-right: 1px solid var(--color-border-tertiary);
    flex-shrink: 0;
  }
  .regex-widget .pattern-delimiter.right {
    border-right: none;
    border-left: 1px solid var(--color-border-tertiary);
  }
  .regex-widget #patternInput {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-primary);
    font-family: var(--mono);
    font-size: 15px;
    padding: 10px 12px;
    min-width: 0;
  }
  .regex-widget #patternInput::placeholder { color: var(--color-text-muted); }
  .regex-widget .pattern-flags-inline {
    display: flex; align-items: center;
    padding: 0 6px;
    background: var(--color-bg-tertiary);
    border-left: 1px solid var(--color-border-tertiary);
    flex-shrink: 0;
  }
  .regex-widget .flag-inline-display {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--color-text-muted);
    padding: 4px 6px;
    min-width: 28px;
    text-align: center;
    letter-spacing: 0.05em;
  }
  .regex-widget .pattern-actions {
    display: flex; align-items: center;
    padding: 0 4px;
    gap: 2px;
    background: var(--color-bg-tertiary);
    border-left: 1px solid var(--color-border-tertiary);
    flex-shrink: 0;
  }
  .regex-widget .icon-btn {
    background: transparent;
    border: none;
    color: var(--color-text-muted);
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 6px;
    font-size: 14px;
    display: flex; align-items: center;
    transition: color 0.12s, background 0.12s;
    min-width: 28px; min-height: 28px;
    justify-content: center;
  }
  .regex-widget .icon-btn:hover { color: var(--color-text-primary); background: var(--color-bg-tertiary); }
  .regex-widget .icon-btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .regex-widget .icon-btn.copied { color: var(--color-text-success); }
  .regex-widget .pattern-error {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--color-text-danger);
    margin-top: 6px;
    min-height: 18px;
    padding: 0 2px;
  }
  .regex-widget .flags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    margin-top: 14px;
  }
  .regex-widget .flags-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-right: 4px;
  }
  .regex-widget .flag-chip {
    position: relative;
    display: inline-flex; align-items: center;
    padding: 4px 12px;
    border-radius: 20px;
    border: 1.5px solid var(--color-border-tertiary);
    background: var(--color-bg-tertiary);
    color: var(--color-text-secondary);
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.12s, color 0.12s, background 0.12s;
    min-width: 36px; min-height: 28px;
    justify-content: center;
  }
  .regex-widget .flag-chip:hover { border-color: var(--color-accent); color: var(--color-text-primary); }
  .regex-widget .flag-chip.active {
    border-color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
  }
  .regex-widget .flag-chip:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .regex-widget .chip-flash { animation: rx-chipFlash 140ms ease; }
  @keyframes rx-chipFlash {
    0%   { filter: invert(0); }
    40%  { filter: invert(0.25); }
    100% { filter: invert(0); }
  }
  .regex-widget .flag-chip[data-tip]::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 7px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-tertiary);
    color: var(--color-text-secondary);
    font-family: inherit;
    font-size: 11px;
    font-weight: 400;
    white-space: nowrap;
    padding: 4px 8px;
    border-radius: 5px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s;
    z-index: 10;
  }
  .regex-widget .flag-chip[data-tip]:hover::after { opacity: 1; }
  .regex-widget .mode-row {
    display: flex; align-items: center; gap: 0;
    border: 1.5px solid var(--color-border-tertiary);
    border-radius: var(--radius);
    overflow: hidden;
    width: fit-content;
    margin-bottom: 14px;
  }
  .regex-widget .mode-btn {
    background: var(--color-bg-tertiary);
    border: none;
    color: var(--color-text-secondary);
    padding: 7px 20px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.12s, color 0.12s;
  }
  .regex-widget .mode-btn + .mode-btn { border-left: 1.5px solid var(--color-border-tertiary); }
  .regex-widget .mode-btn.active {
    background: color-mix(in srgb, var(--color-accent) 18%, var(--color-bg-tertiary));
    color: var(--color-accent);
  }
  .regex-widget .mode-btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 1px; }
  .regex-widget #testInput {
    width: 100%;
    min-height: 120px;
    resize: vertical;
    background: var(--color-bg-tertiary);
    border: 1.5px solid var(--color-border-tertiary);
    border-radius: var(--radius);
    color: var(--color-text-primary);
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.6;
    padding: 12px 14px;
    outline: none;
    tab-size: 2;
    transition: border-color 0.15s;
  }
  .regex-widget #testInput:focus { border-color: var(--color-accent); }
  .regex-widget #testInput::placeholder { color: var(--color-text-muted); }
  .regex-widget .replace-row {
    display: flex; align-items: stretch; gap: 0;
    border: 1.5px solid var(--color-border-tertiary);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-bg-tertiary);
    margin-top: 12px;
    transition: border-color 0.15s;
  }
  .regex-widget .replace-row:focus-within { border-color: var(--color-accent); }
  .regex-widget .replace-prefix {
    display: flex; align-items: center;
    padding: 0 12px;
    background: var(--color-bg-tertiary);
    border-right: 1px solid var(--color-border-tertiary);
    color: var(--color-text-muted);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    flex-shrink: 0;
  }
  .regex-widget #replaceInput {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text-primary);
    font-family: var(--mono);
    font-size: 14px;
    padding: 9px 12px;
  }
  .regex-widget #replaceInput::placeholder { color: var(--color-text-muted); }
  .regex-widget .mirror-wrap {
    position: relative;
    margin-top: 14px;
    border: 1.5px solid var(--color-border-tertiary);
    border-radius: var(--radius);
    background: var(--color-bg-tertiary);
    overflow: hidden;
  }
  .regex-widget .mirror-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 8px 14px 6px;
    border-bottom: 1px solid var(--color-border-tertiary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .regex-widget .mirror-header-right { display: flex; align-items: center; gap: 8px; }
  .regex-widget #matchCount { font-size: 12px; font-weight: 600; color: var(--color-text-secondary); }
  .regex-widget #matchCount.has-matches { color: var(--color-text-success); }
  .regex-widget #matchCount.no-matches  { color: var(--color-text-muted); }
  .regex-widget #matchCount.invalid     { color: var(--color-text-danger); }
  .regex-widget #highlightMirror {
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.6;
    padding: 12px 14px;
    white-space: pre-wrap;
    word-break: break-all;
    min-height: 60px;
    color: var(--color-text-primary);
  }
  .regex-widget .hl-match {
    border-radius: 3px;
    border-bottom: 2px solid;
    cursor: default;
    position: relative;
  }
  .regex-widget .hl-match[data-group-name]::after {
    content: attr(data-group-name);
    position: absolute;
    bottom: calc(100% + 5px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-bg-primary);
    border: 1px solid var(--color-border-tertiary);
    color: var(--color-text-secondary);
    font-size: 11px;
    padding: 2px 7px;
    border-radius: 4px;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.12s;
    z-index: 10;
  }
  .regex-widget .hl-match[data-group-name]:hover::after { opacity: 1; }
  .regex-widget .backtrack-warn {
    color: var(--color-text-warn);
    font-size: 13px;
    margin-top: 8px;
  }
  .regex-widget .match-detail { margin-top: 12px; }
  .regex-widget details.match-detail-inner {
    border: 1px solid var(--color-border-tertiary);
    border-radius: var(--radius);
    background: var(--color-bg-secondary);
    overflow: hidden;
  }
  .regex-widget details.match-detail-inner > summary {
    padding: 9px 14px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text-secondary);
    list-style: none;
