      row.appendChild(num);
      var right = document.createElement('div');
      var textWrap = document.createElement('div');
      textWrap.style.cssText = 'display:flex;align-items:center;gap:8px;flex-wrap:wrap;';
      var textEl = document.createElement('span'); textEl.className = 'match-text'; textEl.textContent = match.value || '(empty)';
      var meta = document.createElement('span'); meta.className = 'match-meta'; meta.textContent = '@ ' + match.index + '–' + match.end;
      textWrap.appendChild(textEl); textWrap.appendChild(meta); right.appendChild(textWrap);
      var namedKeys = Object.keys(match.namedGroups);
      if (match.groups.length > 0 || namedKeys.length > 0) {
        var groupRow = document.createElement('div'); groupRow.className = 'match-groups';
        if (namedKeys.length > 0) {
          namedKeys.forEach(function (k) {
            var tag = document.createElement('span'); tag.className = 'match-group-tag'; tag.textContent = k + ': ' + match.namedGroups[k]; groupRow.appendChild(tag);
          });
        } else {
          match.groups.forEach(function (g, gi) {
            if (g === undefined) return;
            var tag = document.createElement('span'); tag.className = 'match-group-tag'; tag.textContent = '$' + (gi + 1) + ': ' + g; groupRow.appendChild(tag);
          });
        }
        right.appendChild(groupRow);
      }
      row.appendChild(right); frag.appendChild(row);
    });
    if (matches.length > 200) {
      var note = document.createElement('div'); note.className = 'match-meta'; note.style.paddingLeft = '32px';
      note.textContent = '… and ' + (matches.length - 200) + ' more'; frag.appendChild(note);
    }
    matchDetailBody.appendChild(frag);
  }

  function copyText(text, btn, label) {
    navigator.clipboard.writeText(text).then(function () {
      var orig = btn.textContent; btn.textContent = label || '✓ copied'; btn.classList.add('copied');
      setTimeout(function () { btn.textContent = orig; btn.classList.remove('copied'); }, 1500);
    }).catch(function () {});
  }

  copyPatternBtn.addEventListener('click', function () { copyText(patternInput.value, copyPatternBtn, '✓'); });
  copyMatchesBtn.addEventListener('click', function () {
    var payload = lastMatches.map(function (m) {
      return { match: m.value, index: m.index, end: m.end,
        groups: m.groups.length > 0 ? m.groups : undefined,
        namedGroups: Object.keys(m.namedGroups).length > 0 ? m.namedGroups : undefined };
    });
    copyText(JSON.stringify(payload, null, 2), copyMatchesBtn, '✓ copied');
  });
  copyResultBtn.addEventListener('click', function () { copyText(replaceOutput.textContent, copyResultBtn, '✓ copied'); });

  function renderPresets() {
    presetRow.innerHTML = '';
    PRESETS.forEach(function (p) {
      var btn = document.createElement('button');
      btn.className = 'preset-chip';
      btn.textContent = p.label;
      btn.dataset.preset = p.label;
      btn.setAttribute('aria-label', 'Load preset: ' + p.label);
      btn.addEventListener('click', function () {
        flashChip(btn);
        patternInput.value = p.pattern;
        if (p.test) testInput.value = p.test;
        addToHistory(p.pattern);
        render();
      });
      presetRow.appendChild(btn);
    });
  }

  function renderHistory() {
    historyRow.innerHTML = '';
    var h = loadHistory();
    if (h.length === 0) {
      var empty = document.createElement('span'); empty.className = 'history-empty'; empty.textContent = 'No recent patterns yet';
      historyRow.appendChild(empty); return;
    }
    h.forEach(function (pattern) {
      var wrap = document.createElement('button');
      wrap.className = 'history-chip';
      wrap.dataset.historyChip = '';
      wrap.setAttribute('aria-label', 'Load recent pattern: ' + pattern);
      var text = document.createElement('span');
      text.style.cssText = 'max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
      text.textContent = pattern;
      wrap.appendChild(text);
      var x = document.createElement('button');
      x.className = 'history-chip-x';
      x.dataset.historyRemove = pattern;
      x.setAttribute('aria-label', 'Remove from history: ' + pattern);
      x.textContent = '×';
      x.addEventListener('click', function (e) { e.stopPropagation(); removeFromHistory(pattern); });
      wrap.appendChild(x);
      wrap.addEventListener('click', function (e) {
        if (e.target === x) return;
        flashChip(wrap); patternInput.value = pattern; render();
      });
      historyRow.appendChild(wrap);
    });
  }

  flagChips.forEach(function (chip) {
    chip.setAttribute('aria-pressed', chip.classList.contains('active') ? 'true' : 'false');
    chip.setAttribute('role', 'button');
    chip.addEventListener('click', function () {
      flashChip(chip);
      chip.classList.toggle('active');
      chip.setAttribute('aria-pressed', chip.classList.contains('active') ? 'true' : 'false');
      render();
    });
    chip.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); chip.click(); }
    });
  });

  function setMode(newMode) {
    mode = newMode;
    modeTest.classList.toggle('active', mode === 'test');
    modeReplace.classList.toggle('active', mode === 'replace');
    modeTest.setAttribute('aria-pressed', String(mode === 'test'));
    modeReplace.setAttribute('aria-pressed', String(mode === 'replace'));
    if (mode === 'replace') {
      replaceSection.removeAttribute('hidden');
      replaceOutputSection.removeAttribute('hidden');
    } else {
      replaceSection.setAttribute('hidden', '');
      replaceOutputSection.setAttribute('hidden', '');
    }
    render();
  }
  modeTest.addEventListener('click', function () { setMode('test'); });
  modeReplace.addEventListener('click', function () { setMode('replace'); });

  patternInput.addEventListener('input', render);
  testInput.addEventListener('input', render);
  replaceInput.addEventListener('input', render);
  patternInput.addEventListener('blur', function () { if (patternInput.value) addToHistory(patternInput.value); });

  renderPresets();
  renderHistory();
  loadFromURL();
  render();
}());
</script>
</Base>
