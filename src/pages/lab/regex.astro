    { label: 'Named groups', pattern: '(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})',
      test: 'Deployments: 2025-03-14, 2025-09-01, 2024-12-31. Next planned: 2026-01-05.' },
