    var bw = document.querySelector('.regex-widget .backtrack-warn');
    if (bw) bw.remove();
    highlightMirror.textContent = testStr || '';
    matchCount.textContent = '—';
    matchCount.className = reason === 'invalid' ? 'invalid' : 'no-matches';
    matchDetailWrap.setAttribute('hidden', '');
    lastMatches = [];
    if (mode === 'replace') replaceOutput.textContent = testStr;
    pushState();
