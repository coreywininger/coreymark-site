  /* ── Wiring ───────────────────────────────────────────────── */
  var inputEl = document.getElementById('cert-input');
  var decodeBtn = document.getElementById('cert-decode-btn');
  var clearBtn  = document.getElementById('cert-clear-btn');

  function flashChip(el) {
    el.classList.add('flash');
    setTimeout(function() { el.classList.remove('flash'); }, 140);
  }

  function doDecode() {
    var pem = inputEl.value.trim();
    if (!pem) {
      statusEl.hidden = true;
      cardsEl.hidden = true;
      return;
    }
    renderCert(pem);
  }

  decodeBtn.addEventListener('click', doDecode);
  clearBtn.addEventListener('click', function() {
    inputEl.value = '';
    statusEl.hidden = true;
    cardsEl.hidden = true;
  });
  inputEl.addEventListener('input', doDecode);

  document.getElementById('cert-samples').addEventListener('click', function(e) {
    var b = e.target.closest('.cert-chip');
    if (!b) return;
    flashChip(b);
    var key = b.dataset.sample;
    if (SAMPLES[key]) { inputEl.value = SAMPLES[key]; doDecode(); }
  });
})();
