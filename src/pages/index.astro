---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/home/HomeHero.astro';
import TopicMap from '../components/home/TopicMap.astro';
import HomeLab from '../components/home/HomeLab.astro';
import ThingsIRun from '../components/home/ThingsIRun.astro';
---

<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "url": "https://coreymark.com",
    "name": "Corey Wininger",
    "description": "Corey Wininger writes about running IT operations, explaining IT to the business, and where AI actually helps.",
    "author": { "@type": "Person", "name": "Corey Wininger", "url": "https://coreymark.com/about/" }
  })} />
  <HomeHero />
  <TopicMap />
  <HomeLab />
  <ThingsIRun />
</Base>
