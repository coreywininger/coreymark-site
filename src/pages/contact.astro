---
import Base from '../layouts/Base.astro';
import SocialIcon from '../components/SocialIcons.astro';
import { Mail, Rss } from '@lucide/astro';
---

<Base
  title="Contact"
  description="Email, LinkedIn, GitHub — the three places to reach me."
>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent-primary">
        Contact
      </p>
      <h1 class="mb-4 text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
        Three places that reach me.
      </h1>
      <p class="text-lg text-text-secondary">
        Email is best for anything substantive. LinkedIn is fine for
        introductions. GitHub is where the code lives.
      </p>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2">
      <li>
        <a
          href="mailto:corey.wininger@gmail.com"
          class="group flex items-center gap-4 rounded-lg border border-border-subtle bg-bg-elevated p-5 transition-colors hover:border-accent-primary"
        >
          <Mail
            size={22}
            strokeWidth={1.75}
            class="text-text-secondary group-hover:text-accent-primary"
          />
          <div>
            <div class="text-xs uppercase tracking-wide text-text-tertiary">
              Email
            </div>
            <div class="text-text-primary group-hover:text-accent-primary">
              corey.wininger@gmail.com
            </div>
          </div>
        </a>
      </li>

      <li>
        <a
          href="https://www.linkedin.com/in/coreywininger/"
          target="_blank"
          rel="me noopener"
          class="group flex items-center gap-4 rounded-lg border border-border-subtle bg-bg-elevated p-5 transition-colors hover:border-accent-primary"
        >
          <SocialIcon
            name="linkedin"
            size={22}
            class="text-text-secondary group-hover:text-accent-primary"
          />
          <div>
            <div class="text-xs uppercase tracking-wide text-text-tertiary">
              LinkedIn
            </div>
            <div class="text-text-primary group-hover:text-accent-primary">
              in/coreywininger
            </div>
          </div>
        </a>
      </li>

      <li>
        <a
          href="https://github.com/coreywininger"
          target="_blank"
          rel="me noopener"
          class="group flex items-center gap-4 rounded-lg border border-border-subtle bg-bg-elevated p-5 transition-colors hover:border-accent-primary"
        >
          <SocialIcon
            name="github"
            size={22}
            class="text-text-secondary group-hover:text-accent-primary"
          />
          <div>
            <div class="text-xs uppercase tracking-wide text-text-tertiary">
              GitHub
            </div>
            <div class="text-text-primary group-hover:text-accent-primary">
              @coreywininger
            </div>
          </div>
        </a>
      </li>

      <li>
        <a
          href="/rss.xml"
          class="group flex items-center gap-4 rounded-lg border border-border-subtle bg-bg-elevated p-5 transition-colors hover:border-accent-primary"
        >
          <Rss
            size={22}
            strokeWidth={1.75}
            class="text-text-secondary group-hover:text-accent-primary"
          />
          <div>
            <div class="text-xs uppercase tracking-wide text-text-tertiary">
              Subscribe
            </div>
            <div class="text-text-primary group-hover:text-accent-primary">
              RSS feed
            </div>
          </div>
        </a>
      </li>
    </ul>

    <div class="mt-10 rounded-lg border border-border-subtle bg-bg-elevated p-6">
      <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-accent-primary">
        Newsletter
      </p>
      <h2 class="mb-2 text-base font-semibold text-text-primary">
        New posts, straight to your inbox.
      </h2>
      <p class="mb-5 text-sm text-text-secondary">
        No schedule commitment. Unsubscribe any time.
      </p>
      <form
        action="https://buttondown.com/api/emails/embed-subscribe/coreymark"
        method="post"
        target="popupwindow"
        onsubmit="window.open('https://buttondown.com/coreymark', 'popupwindow')"
        class="flex flex-col gap-3 sm:flex-row"
      >
        <input
          type="email"
          name="email"
          id="bd-email-contact"
          placeholder="your@email.com"
          required
          class="flex-1 rounded-md border border-border-subtle bg-transparent px-3 py-2 text-sm text-text-primary placeholder:text-text-tertiary focus:border-accent-primary focus:outline-none"
        />
        <button
          type="submit"
          class="rounded-md bg-accent-primary px-5 py-2 text-sm font-semibold text-white transition-opacity hover:opacity-90"
        >
          Subscribe
        </button>
      </form>
    </div>

    <p class="mt-6 text-sm text-text-tertiary">
      Based in Bedford, IN. Open to on-site Indianapolis, hybrid, or
      remote.
    </p>
  </section>
</Base>
