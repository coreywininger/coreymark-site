---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import StatusPill from '../../components/StatusPill.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SocialIcon from '../../components/SocialIcons.astro';
import ProjectWriteups from '../../components/ProjectWriteups.astro';
import { publishedOnly } from '../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const running = d.status === 'live';
const since = d.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const statusText = running ? `Running since ${since}` : (d.statusLabel ?? (d.status === 'wip' ? 'In progress' : 'Archived'));

// "At a glance": the project's own facts, or a few derived from its data.
const facts =
  d.facts.length > 0
    ? d.facts
    : [
        { label: 'started', value: since },
        ...(d.runsOn ? [{ label: 'runs on', value: d.runsOn }] : []),
        { label: 'status', value: running ? 'Running' : (d.statusLabel ?? 'In progress') },
      ];
const COLORS = ['cyan', 'blue', 'magenta', 'yellow', 'green'];

const hasWriteups =
  Boolean(d.links.writeup) ||
  (await getCollection('blog', (e) => e.data.project === project.id && publishedOnly(e))).length > 0;
const hasBody = (project.body ?? '').trim().length > 0;
---

<Base
  title={d.title}
  description={d.summary}
  ogType="article"
  search={{ kind: 'project', sub: d.tagline ?? d.card ?? d.summary, color: 'yellow' }}
>
  <div data-project-page={project.id}>
    <PageHero
      title={d.title}
      prefix=""
      color="yellow"
      glow="green"
      intro={d.lede ?? d.card ?? d.summary}
      crumbs={[
        { label: 'projects', href: '/projects/', title: 'Projects' },
        { label: project.id, href: `/projects/${project.id}/`, title: d.title },
      ]}
    >
      <div class="hero-row rise d3">
        <StatusPill status={running ? 'running' : 'progress'} label={statusText} />
        {d.links.repo && (
          <a class="btn-ghost" href={d.links.repo} target="_blank" rel="noopener" data-project-repo>
            <SocialIcon name="github" size={16} />View the code on GitHub
          </a>
        )}
        {d.links.live && (
          <a class="btn-ghost" href={d.links.live} target="_blank" rel="noopener" data-project-live>Open it</a>
        )}
      </div>
    </PageHero>

    <div class="wrap">
      <section aria-labelledby="facts-h" data-project-facts>
        <h2 id="facts-h" class="sr-only">At a glance</h2>
        <dl class="facts">
          {facts.map((f, i) => (
            <div class="fact" style={`--c: var(--${COLORS[i % COLORS.length]})`}>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      {d.steps.length > 0 && (
        <section aria-labelledby="flow-h" data-project-steps>
          <SectionHeading id="flow-h" title="How it works" prefix="##" color="cyan" />
          <ol class="steps">
            {d.steps.map((s, i) => (
              <li style={`--c: var(--${COLORS[i % COLORS.length]})`}>
                <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="step-t">{s.title}</span>
                <span class="step-d">{s.text}</span>
              </li>
            ))}
          </ol>
        </section>
      )}

      {(d.why.length > 0 || hasWriteups) && (
        <div class="split">
          {d.why.length > 0 && (
            <section class="why" aria-labelledby="why-h" data-project-why>
              <SectionHeading id="why-h" title="Why I built it" prefix="##" color="magenta" />
              {d.why.map((p) => <p>{p}</p>)}
            </section>
          )}
          {hasWriteups && (
            <section class="wu" aria-labelledby="writeups-h">
              <SectionHeading id="writeups-h" title="Write-ups" prefix="##" color="blue" />
              <ProjectWriteups projectSlug={project.id} featuredWriteupUrl={d.links.writeup} />
            </section>
          )}
        </div>
      )}

      {hasBody && (
        <section aria-labelledby="notes-h" data-project-notes>
          <SectionHeading id="notes-h" title="Build notes" prefix="##" color="yellow" />
          <div class="prose notes">
            <Content />
          </div>
          {d.stack.length > 0 && (
            <ul class="stack" aria-label="Built with">
              {d.stack.map((tech) => <li>{tech}</li>)}
            </ul>
          )}
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .hero-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 24px; }
  .hero-row :global(.btn-ghost) { font-size: 15px; font-weight: 500; padding: 0 16px; gap: 8px; }

  .wrap { max-width: 1120px; margin: 0 auto; padding: 48px 32px 0; display: flex; flex-direction: column; gap: 64px; }
  .wrap :global(.sh) { font-size: 28px; margin-bottom: 20px; }

  .facts { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 14px; }
  .fact { padding: 22px; border-radius: 14px; background: var(--surface2); border: 1px solid var(--line2); }
  dt { margin: 0 0 4px; font-family: var(--font-mono); font-size: 13px; color: var(--text3); }
  dd { margin: 0; font-family: var(--font-head); font-size: 24px; line-height: 1.2; font-weight: 700; color: var(--c); overflow-wrap: anywhere; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(190px, 100%), 1fr)); gap: 14px; }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border-radius: 14px;
    background: var(--bg);
    border: 1px solid var(--line2);
    border-top: 3px solid var(--c);
  }
  .num { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--c); }
  .step-t { font-weight: 700; color: var(--text); }
  .step-d { font-size: 15px; color: var(--text2); }

  .split { display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start; }
  .why { flex: 3 1 420px; min-width: 0; }
  .why p { margin: 0 0 14px; color: var(--text2); font-size: 18px; max-width: 60ch; }
  .wu { flex: 2 1 320px; min-width: 0; }

  .notes { max-width: 70ch; font-size: 17px; --tw-prose-body: var(--text2); }
  .notes :global(h2) { font-size: 22px; margin: 1.6em 0 0.6em; }
  .notes :global(h2:first-child) { margin-top: 0; }
  .stack { list-style: none; margin: 28px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .stack li {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 3px 10px;
    border-radius: 6px;
    color: var(--text2);
    border: 1px solid var(--line2);
  }

  @media (max-width: 560px) {
    .wrap { padding: 32px 16px 0; gap: 48px; }
    dd { font-size: 21px; }
  }
</style>
