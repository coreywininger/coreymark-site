---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Projects"
  description="A selection of things I've built — sometimes to learn, sometimes to scratch an itch."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <header class="mb-10">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-accent-primary">
        Projects
      </p>
      <h1 class="mb-4 text-4xl font-semibold leading-tight tracking-tight md:text-5xl">
        Things I've built.
      </h1>
      <p class="max-w-2xl text-lg text-text-secondary">
        Personal projects and weekend builds. Enterprise work stays at
        work.
      </p>
    </header>

    {projects.length === 0 ? (
      <p class="text-text-secondary">
        Nothing shipped here yet — the first project lands with launch.
      </p>
    ) : (
      <div class="grid gap-5 md:grid-cols-2">
        {projects.map((project) => <ProjectCard project={project} />)}
        <article
          aria-label="More projects coming soon"
          data-empty-state
          class="flex flex-col gap-3 rounded-lg border border-dashed border-border-subtle bg-bg-elevated/60 p-6 opacity-70"
        >
          <span class="text-xs font-semibold uppercase tracking-wide text-text-tertiary">
            Coming soon
          </span>
          <h3 class="text-xl font-semibold leading-tight tracking-tight text-text-secondary">
            More builds in progress
          </h3>
          <p class="text-text-secondary">
            New projects land here as they ship. Check back soon.
          </p>
        </article>
      </div>
    )}
  </section>
</Base>
