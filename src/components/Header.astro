---
import { Menu, Search } from '@lucide/astro';
import ThemePicker from './ThemePicker.astro';

// `color` is the palette token for the square marker in the mobile sheet.
const navItems = [
  { href: '/blog/', label: 'Writing', color: 'cyan' },
  { href: '/lab/', label: 'Lab', color: 'green' },
  { href: '/projects/', label: 'Projects', color: 'yellow' },
  { href: '/now/', label: 'Now', color: 'magenta' },
  { href: '/about/', label: 'About', color: 'blue' },
  { href: '/contact/', label: 'Contact', color: 'accent' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  const base = href.replace(/\/$/, '');
  return pathname === base || pathname.startsWith(`${base}/`);
};
---

<header class="site-header" data-site-header data-pagefind-ignore>
  <div class="bar">
    <a href="/" class="brand" aria-label="Corey Wininger, home" data-brand>
      <span class="keycap" aria-hidden="true"><span class="gt">&gt;</span>_</span>
      <span class="brand-text">
        <span class="brand-name">Corey Wininger<span class="cursor" aria-hidden="true"></span></span>
        <span class="brand-sub slabel">ops · infra · ai</span>
      </span>
    </a>

    <nav aria-label="Main" class="main-nav">
      {navItems.map((item) => (
        <a
          class="navlink top"
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}

      <details class="mnav" data-mobile-nav>
        <summary aria-label="Open menu">
          <Menu size={20} strokeWidth={2} aria-hidden="true" />
        </summary>
        <div class="sheet" id="mobile-menu">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="sq" aria-hidden="true" style={`background: var(--${item.color})`}></span>
              {item.label}
            </a>
          ))}
        </div>
      </details>

      <button type="button" id="search-trigger" class="btn-ghost hbtn" aria-label="Search" aria-keyshortcuts="Meta+K Control+K">
        <Search size={16} strokeWidth={2} aria-hidden="true" />
        <span class="slabel">Search</span>
        <kbd class="slabel kbd" data-search-shortcut aria-hidden="true">
          <span class="k-mac">⌘K</span><span class="k-other">Ctrl K</span>
        </kbd>
      </button>

      <ThemePicker />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--bg) 40%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition: background-color 250ms ease, border-color 250ms ease;
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--line2);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
  }
  .bar {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }
  .brand:hover .keycap { transform: rotate(-8deg) scale(1.08); }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
  }
  .brand-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .brand-sub {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text3);
  }
  .main-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 15px;
    flex: none;
  }
  .hbtn {
    min-height: 44px;
    padding: 0 12px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
  }
  .kbd {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text3);
    border: 1px solid var(--line2);
    border-radius: 4px;
    padding: 0 6px;
  }
  /* Shortcut label per platform; data-platform is set pre-paint in Base. */
  .k-mac { display: none; }
  :global(html[data-platform='mac']) .k-mac { display: inline; }
  :global(html[data-platform='mac']) .k-other { display: none; }

  /* Mobile menu: CSS-only <details> sheet. */
  /* The sheet anchors to the header bar (not the ☰ button, which is not the
     right-most control) so it never runs off the left edge on a phone. */
  .mnav { display: none; }
  .mnav > summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border: 1px solid var(--line2);
    color: var(--text);
    cursor: pointer;
  }
  .mnav > summary::-webkit-details-marker { display: none; }
  .mnav[open] > summary {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .sheet {
    position: absolute;
    right: 32px;
    top: calc(100% - 4px);
    width: min(calc(100vw - 32px), 320px);
    z-index: 45;
    padding: 8px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line2);
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.7);
  }
  .sheet a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 0 14px;
    border-radius: 10px;
    color: var(--text);
    font-size: 17px;
    font-weight: 600;
    text-decoration: none;
  }
  .sheet a:hover,
  .sheet a[aria-current] {
    background: color-mix(in srgb, var(--text) 6%, transparent);
  }
  .sheet a[aria-current] {
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .sq { width: 8px; height: 8px; border-radius: 2px; flex: none; }

  @media (max-width: 920px) {
    .navlink.top { display: none; }
    .mnav { display: block; }
    .site-header :global(.slabel) { display: none; }
    .main-nav { gap: 10px; }
    .hbtn { width: 44px; padding: 0; justify-content: center; }
  }
  @media (max-width: 560px) {
    .bar { padding: 12px 16px; gap: 10px; }
    .sheet { right: 16px; }
    .main-nav { gap: 8px; }
    .brand { gap: 10px; }
    .brand-name { font-size: 17px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const mnav = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');

  // Border + stronger frost once the page has scrolled.
  if (header) {
    let ticking = false;
    const update = () => {
      ticking = false;
      header.toggleAttribute('data-scrolled', window.scrollY > 8);
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }

  // The menu itself is CSS-only. These are conveniences on top: label state,
  // Escape, and click-away.
  if (mnav) {
    const summary = mnav.querySelector('summary');
    mnav.addEventListener('toggle', () => {
      summary?.setAttribute('aria-label', mnav.open ? 'Close menu' : 'Open menu');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mnav.open) {
        mnav.open = false;
        summary?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (mnav.open && !mnav.contains(e.target as Node)) mnav.open = false;
    });
  }
</script>
