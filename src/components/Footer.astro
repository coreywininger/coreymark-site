---
// Evaluated at build time, so the year is the build date's year.
const year = new Date().getFullYear();

interface Props {
  /** No top margin: the page's last section sits directly on the footer. */
  flush?: boolean;
}
const { flush = false } = Astro.props;
---

<footer class:list={['site-footer', flush && 'flush']} data-pagefind-ignore>
  <div class="inner">
    <div class="left">
      <span class="echo"><span class="prompt">$</span> echo "Corey Wininger, Bedford, Indiana"</span>
      <small class="copy" data-copyright>© {year} Corey Wininger</small>
    </div>
    <span class="links">
      <a class="navlink" href="https://www.linkedin.com/in/coreywininger/" rel="me noopener" target="_blank">LinkedIn</a>
      <a class="navlink" href="https://github.com/coreywininger" rel="me noopener" target="_blank">GitHub</a>
      <a class="navlink" href="/rss.xml">RSS</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--line);
    background: var(--surface2);
  }
  .flush { margin-top: 0; }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 36px 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    color: var(--text3);
    font-size: 15px;
  }
  .left { display: flex; flex-direction: column; gap: 6px; }
  .echo { font-family: var(--font-mono); font-size: 14px; }
  .copy { font-size: 13px; color: var(--text3); }
  .prompt { color: var(--green); }
  .links { display: flex; gap: 24px; }
  @media (max-width: 560px) {
    .inner { padding: 28px 16px; }
  }
</style>
