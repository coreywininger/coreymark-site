---
// Write-ups for a project, newest first: posts whose frontmatter `project`
// matches, plus the project's featured write-up. No post is listed twice.
import { getCollection } from 'astro:content';
import { publishedOnly, sortByPubDateDesc } from '../lib/content';
import { topicFor } from '../data/topics';

interface Props {
  projectSlug: string;
  featuredWriteupUrl?: string;
}

const { projectSlug, featuredWriteupUrl } = Astro.props;

const matches = await getCollection(
  'blog',
  (entry) => entry.data.project === projectSlug && publishedOnly(entry),
);
const sorted = sortByPubDateDesc(matches);

const normalize = (url: string) => {
  try {
    return new URL(url, 'https://coreymark.com').pathname.replace(/\/+$/, '');
  } catch {
    return url.replace(/\/+$/, '');
  }
};

const featuredPath = featuredWriteupUrl ? normalize(featuredWriteupUrl) : null;
const allPosts = featuredPath ? await getCollection('blog', publishedOnly) : [];
const featuredPost = featuredPath
  ? allPosts.find((entry) => normalize(`/blog/${entry.id}`) === featuredPath)
  : undefined;

// Newest first. The featured write-up is included even if it is not tagged
// with the project, and never twice.
const ordered = sortByPubDateDesc([
  ...sorted,
  ...(featuredPost && !sorted.some((e) => e.id === featuredPost.id) ? [featuredPost] : []),
]);

const shortDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
---

{ordered.length > 0 && (
  <div class="writeups" data-project-writeups>
    {ordered.map((entry) => {
      const t = topicFor(entry.data.pillar);
      return (
        <a class="card" href={`/blog/${entry.id}/`} style={`--c: var(--${t.color})`} data-writeup-link>
          <span class="meta"><span class="topic">{t.label}</span> · <time datetime={entry.data.pubDate.toISOString().slice(0, 10)}>{shortDate(entry.data.pubDate)}</time></span>
          <span class="title">{entry.data.title}</span>
        </a>
      );
    })}
  </div>
)}

<style>
  .writeups { display: flex; flex-direction: column; gap: 12px; }
  .card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--bg);
    border: 1px solid var(--line2);
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 200ms ease;
  }
  .card:hover {
    border-color: var(--c);
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -18px color-mix(in srgb, var(--c) 60%, transparent);
  }
  .meta { font-size: 13px; color: var(--text3); }
  .topic { color: var(--c); font-weight: 600; }
  .title { font-weight: 700; color: var(--text); }
</style>
