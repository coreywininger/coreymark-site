---
import { getCollection } from 'astro:content';
import { publishedOnly, sortByPubDateDesc } from '../lib/content';

interface Props {
  projectSlug: string;
  featuredWriteupUrl?: string;
}

const { projectSlug, featuredWriteupUrl } = Astro.props;

const matches = await getCollection(
  'blog',
  (entry) => entry.data.project === projectSlug && publishedOnly(entry),
);
const sorted = sortByPubDateDesc(matches);

const normalize = (url: string) => {
  try {
    const parsed = new URL(url, 'https://coreymark.com');
    return parsed.pathname.replace(/\/+$/, '');
  } catch {
    return url.replace(/\/+$/, '');
  }
};

const featuredPath = featuredWriteupUrl ? normalize(featuredWriteupUrl) : null;

const featuredPost = featuredPath
  ? sorted.find((entry) => normalize(`/blog/${entry.id}`) === featuredPath)
  : null;

const remaining = sorted.filter((entry) => {
  if (!featuredPath) return true;
  return normalize(`/blog/${entry.id}`) !== featuredPath;
});

const hasFeaturedUrl = Boolean(featuredWriteupUrl);
const hasAny = hasFeaturedUrl || remaining.length > 0;

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

{hasAny && (
  <section
    data-project-writeups
    aria-label="Writeups"
    class="mt-12 border-t border-border-subtle pt-8"
  >
    {hasFeaturedUrl && (
      <div class="mb-8">
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-accent-primary">
          Featured writeup
        </h2>
        <a
          data-writeup-link
          href={featuredWriteupUrl}
          class="group block rounded-lg border border-border-subtle bg-bg-elevated p-5 transition-colors hover:border-accent-primary"
        >
          <div class="text-lg font-semibold text-text-primary group-hover:text-accent-primary">
            {featuredPost ? featuredPost.data.title : 'Featured writeup'}
          </div>
          {featuredPost && (
            <p class="mt-2 text-sm text-text-secondary">
              {featuredPost.data.description}
            </p>
          )}
        </a>
      </div>
    )}

    {remaining.length > 0 && (
      <>
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-text-tertiary">
          {hasFeaturedUrl ? 'More writeups' : 'Writeups'}
        </h2>
        <ul class="space-y-3">
          {remaining.map((entry) => (
            <li>
              <a
                data-writeup-link
                href={`/blog/${entry.id}/`}
                class="group block rounded-lg border border-border-subtle bg-bg-elevated p-4 transition-colors hover:border-accent-primary"
              >
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <span class="text-base font-medium text-text-primary group-hover:text-accent-primary">
                    {entry.data.title}
                  </span>
                  <time
                    datetime={entry.data.pubDate.toISOString()}
                    class="text-xs text-text-tertiary"
                  >
                    {formatDate(entry.data.pubDate)}
                  </time>
                </div>
                <p class="mt-1 text-sm text-text-secondary">
                  {entry.data.description}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>
)}
