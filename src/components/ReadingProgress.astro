---
// Thin gradient reading-progress bar pinned to the top of the viewport.
// Vanilla replacement for the old React island. `color` is a palette token
// (the post's pillar color); the bar runs from it to magenta.
interface Props {
  color?: string;
}
const { color = 'accent' } = Astro.props;
---

<div class="rp" aria-hidden="true" data-reading-progress style={`--c: var(--${color})`}>
  <div class="rp-bar"></div>
</div>

<style>
  .rp {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }
  .rp-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--c), var(--magenta));
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-progress] .rp-bar');
  if (bar) {
    let frame = 0;
    const update = () => {
      frame = 0;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      bar.style.transform = `scaleX(${p})`;
    };
    const queue = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    update();
  }
</script>
