---
import { Network, Server, Shield, GitBranch, Cloud, Clock, KeyRound, Lock, Regex, ArrowLeftRight, FileQuestionMark } from '@lucide/astro';
import type { LabTool } from '../data/lab-tools';
import { disciplineLabel, isToolNew } from '../data/lab-tools';

interface Props {
  tool: LabTool;
}

const { tool } = Astro.props;

const iconMap = {
  network: Network,
  server: Server,
  shield: Shield,
  git: GitBranch,
  cloud: Cloud,
  clock: Clock,
  'key-round': KeyRound,
  lock: Lock,
  regex: Regex,
  'arrow-left-right': ArrowLeftRight,
  'file-question-mark': FileQuestionMark,
} as const;

const Icon = iconMap[tool.icon as keyof typeof iconMap] ?? Network;
const displayDate = tool.updated ?? tool.added;
const dateLabel = tool.updated ? 'Updated' : 'Added';
---

<article
  class="group relative flex flex-col gap-4 rounded-lg border border-border-subtle bg-bg-elevated p-6 transition-colors hover:border-accent-primary"
  data-lab-tool={tool.slug}
>
  {isToolNew(tool.added) && (
    <span
      class="absolute right-4 top-4 rounded-full border border-accent-primary/40 bg-accent-primary/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-accent-primary"
      data-lab-new-badge
    >
      New
    </span>
  )}

  <div class="text-accent-primary">
    <Icon size={32} strokeWidth={1.5} aria-hidden="true" />
  </div>

  <h3 class="text-xl font-semibold leading-tight tracking-tight">
    <a
      href={`/lab/${tool.slug}/`}
      class="after:absolute after:inset-0 group-hover:text-accent-primary"
    >
      {tool.title}
    </a>
  </h3>

  <p class="text-text-secondary">{tool.description}</p>

  <div class="mt-auto flex flex-wrap items-center gap-3 pt-2 text-xs text-text-tertiary">
    <span class="rounded border border-border-subtle bg-bg-subtle px-2 py-0.5">
      {disciplineLabel(tool.discipline)}
    </span>
    <span>{dateLabel} {displayDate}</span>
  </div>
</article>
