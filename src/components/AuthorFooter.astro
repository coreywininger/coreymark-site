---
import { Image } from 'astro:assets';
import { Mail, Rss } from '@lucide/astro';
import SocialIcon from './SocialIcons.astro';
import headshot from '../assets/headshot.jpg';
---

<aside
  data-author-footer
  aria-label="About the author"
  class="mt-16 flex flex-col gap-5 rounded-lg border border-border-subtle bg-bg-elevated p-6 sm:flex-row sm:items-start sm:gap-6"
>
  <Image
    src={headshot}
    alt="Corey Wininger"
    width={96}
    height={96}
    loading="lazy"
    class="h-20 w-20 flex-shrink-0 rounded-full border border-border-subtle sm:h-24 sm:w-24"
  />
  <div class="min-w-0">
    <div class="text-sm font-semibold uppercase tracking-wide text-accent-primary">
      Corey Wininger
    </div>
    <p class="mt-2 text-text-secondary">
      I'm an IT infrastructure leader writing about IT operations, AI in
      the enterprise, and hybrid cloud. Based in Bedford, Indiana.
    </p>
    <ul class="mt-4 flex flex-wrap items-center gap-5">
      <li>
        <a
          href="https://www.linkedin.com/in/coreywininger/"
          rel="me noopener"
          target="_blank"
          class="text-text-secondary transition-colors hover:text-accent-primary"
          aria-label="LinkedIn"
        >
          <SocialIcon name="linkedin" size={20} />
        </a>
      </li>
      <li>
        <a
          href="https://github.com/coreywininger"
          rel="me noopener"
          target="_blank"
          class="text-text-secondary transition-colors hover:text-accent-primary"
          aria-label="GitHub"
        >
          <SocialIcon name="github" size={20} />
        </a>
      </li>
      <li>
        <a
          href="/rss.xml"
          class="text-text-secondary transition-colors hover:text-accent-primary"
          aria-label="RSS feed"
        >
          <Rss size={20} strokeWidth={1.75} />
        </a>
      </li>
      <li>
        <a
          href="mailto:corey.wininger@gmail.com"
          class="text-text-secondary transition-colors hover:text-accent-primary"
          aria-label="Email"
        >
          <Mail size={20} strokeWidth={1.75} />
        </a>
      </li>
    </ul>
  </div>
</aside>
