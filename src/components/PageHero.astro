---
// Shared page hero: grid + glow background, breadcrumb, `~/` heading, intro.
// `color` is the page's palette token (heading prefix, current crumb, first
// glow). Default slot renders under the intro; `before` renders between the
// breadcrumb and the heading (e.g. a topic chip).
import Crumbs from './Crumbs.astro';

interface Props {
  title: string;
  /** Prefix before the title, e.g. "~/" or "$ ". Pass "" for none. */
  prefix?: string;
  intro?: string;
  crumbs?: { label: string; href: string; title?: string }[];
  color?: string;
  /** Second glow color token. */
  glow?: string;
}
const { title, prefix = '~/', intro, crumbs, color = 'accent', glow = 'magenta' } = Astro.props;
---

<section class="hero" style={`--c: var(--${color}); --g: var(--${glow})`} data-page-hero>
  <div class="hero-bg" aria-hidden="true">
    <div class="grid-bg"></div>
    <div class="blob one"></div>
    <div class="blob b2 two"></div>
  </div>
  <div class="hero-inner">
    {crumbs && crumbs.length > 0 && <div class="hero-crumbs"><Crumbs items={crumbs} color={color} /></div>}
    <slot name="before" />
    <h1 class="rise d1">
      {prefix && <span class="pre" aria-hidden="true">{prefix}</span>}{title}
    </h1>
    {intro && <p class="intro rise d2">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .hero-bg { position: absolute; inset: 0; pointer-events: none; }
  .hero-bg .grid-bg { position: absolute; inset: 0; }
  .one { width: 480px; height: 480px; left: -160px; top: -220px; background: var(--c); }
  .two { width: 360px; height: 360px; right: -40px; top: -60px; background: var(--g); }
  .hero-inner {
    position: relative;
    max-width: 1120px;
    margin: 0 auto;
    padding: 64px 32px 48px;
  }
  .hero-crumbs { margin-bottom: 24px; }
  h1 {
    margin: 0 0 16px;
    font-size: clamp(40px, 5vw, 58px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .pre {
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--c);
  }
  .intro {
    margin: 0;
    font-size: 19px;
    color: var(--text2);
    max-width: 56ch;
  }
  @media (max-width: 560px) {
    .hero-inner { padding: 40px 16px 36px; }
  }
</style>
