---
import SocialIcon from './SocialIcons.astro';
import { Link2 } from '@lucide/astro';

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const linkedInHref = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const xHref = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`;
---

<div class="mt-10 flex flex-wrap items-center gap-4 border-t border-border-subtle pt-6">
  <span class="text-xs font-semibold uppercase tracking-wide text-text-tertiary">
    Share
  </span>
  <div class="flex items-center gap-5">
    <a
      href={linkedInHref}
      target="_blank"
      rel="noopener noreferrer"
      class="text-text-secondary transition-colors hover:text-accent-primary"
      aria-label="Share on LinkedIn"
    >
      <SocialIcon name="linkedin" size={20} />
    </a>
    <a
      href={xHref}
      target="_blank"
      rel="noopener noreferrer"
      class="text-text-secondary transition-colors hover:text-accent-primary"
      aria-label="Share on X"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
      </svg>
    </a>
    <button
      data-copy-url={url}
      class="flex items-center gap-1.5 text-text-secondary transition-colors hover:text-accent-primary"
      aria-label="Copy link to post"
    >
      <Link2 size={20} strokeWidth={1.75} />
      <span data-copy-label class="text-sm">Copy link</span>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-url]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.copyUrl ?? '';
      try {
        await navigator.clipboard.writeText(url);
        const label = btn.querySelector('[data-copy-label]');
        if (label) {
          label.textContent = 'Copied!';
          setTimeout(() => {
            label.textContent = 'Copy link';
          }, 2000);
        }
      } catch {
        // clipboard unavailable — fail silently
      }
    });
  });
</script>
