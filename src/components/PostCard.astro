---
import type { CollectionEntry } from 'astro:content';
import { PILLAR_META } from '../content.config';
import { readingTime } from '../lib/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props;
const { title, description, pubDate, pillar, draft } = post.data;
const pillarLabel = PILLAR_META[pillar].label;
const minutes = readingTime(post.body ?? '');

const dateStr = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const Heading = `h${headingLevel}` as const;
---

<article
  class="group relative flex flex-col gap-3 rounded-lg border border-border-subtle bg-bg-elevated p-6 transition-colors hover:border-accent-primary focus-within:ring-2 focus-within:ring-accent-primary focus-within:ring-offset-2 focus-within:ring-offset-bg-primary"
  data-pillar={pillar}
>
  <div class="flex items-center gap-3 text-xs">
    <span class="font-semibold uppercase tracking-wide text-accent-primary">
      {pillarLabel}
    </span>
    <span class="text-text-tertiary">·</span>
    <time class="text-text-tertiary" datetime={pubDate.toISOString()}>
      {dateStr}
    </time>
    <span class="text-text-tertiary">·</span>
    <span class="text-text-tertiary">{minutes} min read</span>
    {draft && (
      <>
        <span class="text-text-tertiary">·</span>
        <span class="rounded bg-bg-subtle px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-accent-secondary">
          Draft
        </span>
      </>
    )}
  </div>

  <Heading class="text-xl font-semibold leading-tight tracking-tight">
    <a
      href={`/blog/${post.id}/`}
      class="after:absolute after:inset-0 group-hover:text-accent-primary"
    >
      {title}
    </a>
  </Heading>

  <p class="text-text-secondary">{description}</p>
</article>
