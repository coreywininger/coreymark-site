---
// Site search (⌘K / Ctrl K). A small custom UI on the Pagefind JS API:
// dimmed, blurred backdrop; 680px panel; results grouped by kind with a
// colored dot; arrow keys move, Enter opens, Esc closes.
// The index only exists in a built site (`npm run build`), not in `astro dev`.
import { Search } from '@lucide/astro';

// Shown before anything is typed.
const quick = [
  { href: '/blog/', title: 'Writing', sub: 'Every post, newest first', color: 'cyan' },
  { href: '/lab/', title: 'Lab', sub: 'Small IT tools that run in your browser', color: 'green' },
  { href: '/projects/', title: 'Projects', sub: 'Side projects I built and still keep running', color: 'yellow' },
  { href: '/now/', title: 'Now', sub: 'What I am focused on right now', color: 'magenta' },
  { href: '/about/', title: 'About', sub: 'Who writes this', color: 'blue' },
  { href: '/contact/', title: 'Contact', sub: 'Email, LinkedIn, GitHub', color: 'accent' },
];
---

<div id="search-overlay" class="search-overlay" aria-hidden="true" data-search-overlay>
  <div class="search-overlay-backdrop" data-search-backdrop></div>
  <div class="panel" role="dialog" aria-modal="true" aria-labelledby="search-h">
    <h2 id="search-h" class="sr-only">Search the site</h2>
    <div class="field">
      <Search size={20} strokeWidth={2} aria-hidden="true" class="icon" />
      <input
        type="search"
        id="site-search-input"
        role="combobox"
        aria-label="Search posts, tools and pages"
        aria-controls="search-results"
        aria-expanded="true"
        aria-autocomplete="list"
        placeholder="Search posts, tools and pages"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
      <button type="button" id="search-close" class="esc" aria-label="Close search" data-search-close>esc</button>
    </div>

    <div class="results" id="search-results" role="listbox" aria-label="Results" data-search-results>
      <div class="group" role="group" aria-label="Pages" data-search-quick>
        <p class="group-label" aria-hidden="true">Pages</p>
        {quick.map((q, i) => (
          <a class="item" role="option" id={`sr-q${i}`} aria-selected="false" href={q.href} style={`--c: var(--${q.color})`} data-search-item>
            <span class="dot" aria-hidden="true"></span>
            <span class="text"><span class="t">{q.title}</span><span class="d">{q.sub}</span></span>
            <span class="enter" aria-hidden="true">↵</span>
          </a>
        ))}
      </div>
    </div>
    <p class="status" role="status" data-search-status></p>

    <div class="hints" aria-hidden="true"><span>↑↓ move</span><span>↵ open</span><span>esc close</span></div>
  </div>
</div>

<style>
  .search-overlay { display: none; position: fixed; inset: 0; z-index: 1000; }
  .search-overlay.open { display: block; }
  .search-overlay-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .panel {
    position: relative;
    width: min(680px, calc(100vw - 32px));
    margin: 88px auto 0;
    max-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line2);
    border-radius: 16px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.75);
  }
  .field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 18px;
    min-height: 64px;
    border-bottom: 1px solid var(--line);
  }
  .field :global(.icon) { flex: none; color: var(--accent); }
  input {
    flex: 1;
    min-width: 0;
    height: 62px;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--text);
    font-family: inherit;
    font-size: 19px;
  }
  input::placeholder { color: var(--text3); opacity: 1; }
  input::-webkit-search-cancel-button { display: none; }
  .field:focus-within { box-shadow: inset 0 -2px 0 var(--accent); }
  .esc {
    flex: none;
    min-width: 44px;
    min-height: 44px;
    background: transparent;
    border: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text2);
  }
  .esc:hover { color: var(--text); }

  .results { flex: 1; min-height: 0; max-height: 520px; overflow-y: auto; padding: 8px; }
  .results :global(.group) { padding: 8px 6px; }
  .results :global(.group-label) { margin: 6px 10px; font-family: var(--font-mono); font-size: 12px; color: var(--text3); }
  .results :global(.item) {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    padding: 12px 14px;
    border-radius: 10px;
    text-decoration: none;
    border: 1px solid transparent;
    scroll-margin: 8px;
  }
  .results :global(.item:hover) { background: color-mix(in srgb, var(--text) 5%, transparent); }
  .results :global(.item[aria-selected='true']) {
    background: color-mix(in srgb, var(--c) 14%, transparent);
    border-color: color-mix(in srgb, var(--c) 40%, transparent);
  }
  .results :global(.dot) { flex: none; width: 8px; height: 8px; border-radius: 2px; background: var(--c); }
  .results :global(.text) { flex: 1; min-width: 0; }
  .results :global(.t) { display: block; color: var(--text); font-weight: 600; }
  .results :global(.d) { display: block; font-size: 14px; color: var(--text2); overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .results :global(.d mark) { background: transparent; color: var(--text); font-weight: 600; }
  .results :global(.enter) {
    display: none;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text2);
    border: 1px solid var(--line2);
    border-radius: 4px;
    padding: 1px 6px;
  }
  .results :global(.item[aria-selected='true'] .enter) { display: inline; }
  .status { margin: 0; padding: 0 24px; text-align: center; color: var(--text2); }
  .status:not(:empty) { padding: 24px; }
  .hints {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 10px 18px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text3);
  }
  @media (max-width: 560px) {
    .panel { margin-top: 16px; max-height: calc(100vh - 32px); }
    .hints { display: none; }
  }
</style>

<script>
  type Hit = { url: string; title: string; sub: string; subIsHtml: boolean; kind: string; color: string };

  const overlay = document.querySelector<HTMLElement>('[data-search-overlay]');
  if (overlay) {
    const panel = overlay.querySelector<HTMLElement>('.panel')!;
    const input = overlay.querySelector<HTMLInputElement>('[data-search-input]')!;
    const results = overlay.querySelector<HTMLElement>('[data-search-results]')!;
    const status = overlay.querySelector<HTMLElement>('[data-search-status]')!;
    const quickHtml = results.innerHTML;

    const GROUPS: Record<string, string> = { post: 'Posts', tool: 'Lab tools', project: 'Projects', page: 'Pages' };
    const COLORS = new Set(['red', 'green', 'yellow', 'blue', 'magenta', 'cyan', 'accent', 'text']);
    const MAX = 8;

    let pagefind: any = null;
    let loadFailed = false;
    let lastFocus: HTMLElement | null = null;
    let active = -1;
    let seq = 0;

    const items = () => [...results.querySelectorAll<HTMLAnchorElement>('[data-search-item]')];

    const setActive = (i: number, scroll = true) => {
      const list = items();
      active = list.length ? (i + list.length) % list.length : -1;
      list.forEach((el, n) => el.setAttribute('aria-selected', n === active ? 'true' : 'false'));
      const el = list[active];
      if (el) {
        input.setAttribute('aria-activedescendant', el.id);
        if (scroll) el.scrollIntoView({ block: 'nearest' });
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    };

    const kindFor = (url: string, meta: Record<string, string>) => {
      if (meta.kind && GROUPS[meta.kind]) return meta.kind;
      if (/^\/blog\/[^/]+\/?$/.test(url)) return 'post';
      if (/^\/lab\/[^/]+\/?$/.test(url)) return 'tool';
      if (/^\/projects\/[^/]+\/?$/.test(url)) return 'project';
      return 'page';
    };

    const render = (hits: Hit[]) => {
      results.textContent = '';
      // Groups appear in order of their best hit, so the top result is first.
      const order: string[] = [];
      for (const h of hits) if (!order.includes(h.kind)) order.push(h.kind);
      let n = 0;
      for (const kind of order) {
        const group = document.createElement('div');
        group.className = 'group';
        group.setAttribute('role', 'group');
        group.setAttribute('aria-label', GROUPS[kind]);
        const label = document.createElement('p');
        label.className = 'group-label';
        label.setAttribute('aria-hidden', 'true');
        label.textContent = GROUPS[kind];
        group.append(label);
        for (const h of hits.filter((x) => x.kind === kind)) {
          const a = document.createElement('a');
          a.className = 'item';
          a.href = h.url;
          a.id = `sr-${n++}`;
          a.setAttribute('role', 'option');
          a.setAttribute('aria-selected', 'false');
          a.dataset.searchItem = '';
          a.dataset.kind = h.kind;
          a.style.setProperty('--c', `var(--${COLORS.has(h.color) ? h.color : 'accent'})`);
          const dot = document.createElement('span');
          dot.className = 'dot';
          dot.setAttribute('aria-hidden', 'true');
          const text = document.createElement('span');
          text.className = 'text';
          const t = document.createElement('span');
          t.className = 't';
          t.textContent = h.title;
          const d = document.createElement('span');
          d.className = 'd';
          // Pagefind excerpts are HTML-escaped by Pagefind, with <mark> added.
          if (h.subIsHtml) d.innerHTML = h.sub;
          else d.textContent = h.sub;
          text.append(t, d);
          const enter = document.createElement('span');
          enter.className = 'enter';
          enter.setAttribute('aria-hidden', 'true');
          enter.textContent = '↵';
          a.append(dot, text, enter);
          group.append(a);
        }
        results.append(group);
      }
      setActive(hits.length ? 0 : -1, false);
    };

    const showQuick = () => {
      results.innerHTML = quickHtml;
      status.textContent = '';
      setActive(0, false);
    };

    const load = async () => {
      if (pagefind || loadFailed) return;
      try {
        // Built by `pagefind --site dist`; resolved at runtime, not bundled.
        const path = '/pagefind/pagefind.js';
        pagefind = await import(/* @vite-ignore */ path);
        await pagefind.options({ excerptLength: 18 });
        pagefind.init();
      } catch {
        loadFailed = true;
      }
    };

    const search = async () => {
      const q = input.value.trim();
      const mine = ++seq;
      if (!q) return showQuick();
      await load();
      if (mine !== seq) return;
      if (!pagefind) {
        results.textContent = '';
        setActive(-1);
        status.textContent = 'Search is not available right now.';
        return;
      }
      const res = await pagefind.debouncedSearch(q, {}, 120);
      if (res === null || mine !== seq) return; // superseded by a newer keystroke
      const data = await Promise.all(res.results.slice(0, MAX).map((r: any) => r.data()));
      if (mine !== seq) return;
      const hits: Hit[] = data.map((d: any) => {
        const meta = d.meta ?? {};
        const url = String(d.url).replace(/index\.html$/, '');
        return {
          url,
          title: meta.title || url,
          sub: meta.sub || d.excerpt || '',
          subIsHtml: !meta.sub,
          kind: kindFor(url, meta),
          color: meta.color || 'accent',
        };
      });
      render(hits);
      status.textContent = hits.length ? '' : 'No matches. Try a shorter word, like "cron" or "vendor".';
    };

    const open = () => {
      if (overlay.classList.contains('open')) return;
      lastFocus = document.activeElement as HTMLElement | null;
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      input.value = '';
      showQuick();
      input.focus();
      void load(); // warm the index while the reader types
    };

    const close = () => {
      if (!overlay.classList.contains('open')) return;
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lastFocus?.focus?.();
    };

    document.getElementById('search-trigger')?.addEventListener('click', open);
    document.querySelectorAll('[data-open-search]').forEach((el) => el.addEventListener('click', open));
    overlay.querySelector('[data-search-close]')?.addEventListener('click', close);
    overlay.querySelector('[data-search-backdrop]')?.addEventListener('click', close);
    input.addEventListener('input', search);

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        open();
        return;
      }
      if (!overlay.classList.contains('open')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === 'Enter' && document.activeElement === input) {
        const el = items()[active];
        if (el) {
          e.preventDefault();
          el.click();
        }
      } else if (e.key === 'Tab') {
        // Keep focus inside the dialog.
        const focusable = [...panel.querySelectorAll<HTMLElement>('input, button, a[href]')];
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
