# build output
dist/
# generated types
.astro/

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.*
!.env.example

# local secrets / credentials
*.pem
*.key
credentials.json
token.json

# OS junk
.DS_Store
Thumbs.db

# jetbrains setting folder
.idea/

# claude code preview / local agent config (per-repo launch.json lives in workspace)
.claude/

# vscode — personal editor settings stay personal; carve out exceptions
# (e.g. !.vscode/extensions.json) if we want to share project settings
.vscode/

# terraform — commit .terraform.lock.hcl for reproducibility, exclude everything else
terraform/.terraform/
terraform/.terraform.tfstate.lock.info
terraform/terraform.tfstate
terraform/terraform.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/crash.log
terraform/crash.*.log
terraform/tfplan
terraform/*.tfplan
